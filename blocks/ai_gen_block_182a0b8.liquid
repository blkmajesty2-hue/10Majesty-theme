{% doc %}
  @prompt
    reviews section  <section class="reviews"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">From the reference store</p><h2>Customer experiences.</h2></div><p>Source reports 6,000+ customers.<br>English summaries, not verbatim reviews.</p></div><div class="reviews-track"><article class="review"><img src="assets/belayan-review-1.webp" alt="Reference customer image: Chiara, 44" class="" loading="lazy"><div><span class="stars">★★★★★</span><h3>Chiara, 44</h3><p>Describes feeling more comfortable in her jeans with the wraparound support.</p><small>Summary of a source-store testimonial</small></div></article><article class="review"><img src="assets/belayan-review-2.webp" alt="Reference customer image: Alessandra, 49" class="" loading="lazy"><div><span class="stars">★★★★★</span><h3>Alessandra, 49</h3><p>Highlights the fit and ease of wearing the brief throughout the day.</p><small>Summary of a source-store testimonial</small></div></article><article class="review"><img src="assets/belayan-review-3.webp" alt="Reference customer image: Cristina, 52" class="" loading="lazy"><div><span class="stars">★★★★★</span><h3>Cristina, 52</h3><p>Focuses on the cross-band feel while sitting, standing and moving.</p><small>Summary of a source-store testimonial</small></div></article><article class="review"><img src="assets/belayan-review-4.webp" alt="Reference customer image: Valentina, 47" class="" loading="lazy"><div><span class="stars">★★★★★</span><h3>Valentina, 47</h3><p>Values the defined waist and how easily the brief fits into her routine.</p><small>Summary of a source-store testimonial</small></div></article><article class="review"><img src="assets/belayan-review-5.webp" alt="Reference customer image: Serena, 56" class="" loading="lazy"><div><span class="stars">★★★★★</span><h3>Serena, 56</h3><p>Describes feeling more confident getting dressed for a special dinner.</p><small>Summary of a source-store testimonial</small></div></article><article class="review"><img src="assets/belayan-review-6.webp" alt="Reference customer image: Giorgia, 34" class="" loading="lazy"><div><span class="stars">★★★★★</span><h3>Giorgia, 34</h3><p>Shares how the high-waist silhouette looked beneath a dress.</p><small>Summary of a source-store testimonial</small></div></article><article class="review"><img src="assets/belayan-review-7.webp" alt="Reference customer image: Martina, 38" class="" loading="lazy"><div><span class="stars">★★★★★</span><h3>Martina, 38</h3><p>Discusses a smoother appearance beneath fitted clothing.</p><small>Summary of a source-store testimonial</small></div></article><article class="review"><img src="assets/belayan-review-8.webp" alt="Reference customer image: Paola, 57" class="" loading="lazy"><div><span class="stars">★★★★★</span><h3>Paola, 57</h3><p>Describes wearing a favorite dress to a family wedding.</p><small>Summary of a source-store testimonial</small></div></article><article class="review"><img src="assets/belayan-review-1.webp" alt="Reference customer image: Rosa, 63" class="" loading="lazy"><div><span class="stars">★★★★★</span><h3>Rosa, 63</h3><p>Focuses on comfort and enjoying a family occasion without fuss.</p><small>Summary of a source-store testimonial</small></div></article></div></div></section><!--
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 40px 0;
  }

  .ai-reviews-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .ai-reviews-{{ ai_gen_id }}__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }

  .ai-reviews-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 8px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .ai-reviews-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: clamp(26px, 4vw, 42px);
    line-height: 1.1;
  }

  .ai-reviews-{{ ai_gen_id }}__intro {
    max-width: 360px;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.6;
  }

  .ai-reviews-{{ ai_gen_id }}__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .ai-reviews-{{ ai_gen_id }}__card {
    overflow: hidden;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 12px;
    background: {{ block.settings.card_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-reviews-{{ ai_gen_id }}__image,
  .ai-reviews-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #f1f1f1;
  }

  .ai-reviews-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-reviews-{{ ai_gen_id }}__body {
    padding: 20px;
  }

  .ai-reviews-{{ ai_gen_id }}__body h3 {
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
    font-size: 17px;
  }

  .ai-reviews-{{ ai_gen_id }}__quote {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 15px;
    line-height: 1.6;
  }

  .ai-reviews-{{ ai_gen_id }}__empty {
    padding: 26px 20px;
    border: 1px dashed {{ block.settings.border_color }};
    border-radius: 12px;
    color: {{ block.settings.text_color }};
    text-align: center;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-{{ ai_gen_id }}__inner { padding: 0 16px; }
    .ai-reviews-{{ ai_gen_id }}__heading { display: block; }
    .ai-reviews-{{ ai_gen_id }}__intro { margin-top: 12px; }
    .ai-reviews-{{ ai_gen_id }}__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 8px;
    }
    .ai-reviews-{{ ai_gen_id }}__card {
      flex: 0 0 min(82%, 320px);
      scroll-snap-align: start;
    }
  }
{% endstyle %}

<section class="ai-reviews-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-{{ ai_gen_id }}__inner">
    <header class="ai-reviews-{{ ai_gen_id }}__heading">
      <div>
        {% if block.settings.eyebrow != blank %}<p class="ai-reviews-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
        {% if block.settings.heading != blank %}<h2 class="ai-reviews-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}
      </div>
      {% if block.settings.intro != blank %}<p class="ai-reviews-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape | newline_to_br }}</p>{% endif %}
    </header>
    <div class="ai-reviews-{{ ai_gen_id }}__track">
      {% assign visible_reviews = 0 %}
      {% for i in (1..3) %}
        {% assign name_key = 'review_' | append: i | append: '_name' %}
        {% assign quote_key = 'review_' | append: i | append: '_quote' %}
        {% assign image_key = 'review_' | append: i | append: '_image' %}
        {% assign review_name = block.settings[name_key] %}
        {% assign review_quote = block.settings[quote_key] %}
        {% assign review_image = block.settings[image_key] %}
        {% if review_name != blank or review_quote != blank or review_image != blank %}
          {% assign visible_reviews = visible_reviews | plus: 1 %}
          <article class="ai-reviews-{{ ai_gen_id }}__card">
            {% if review_image != blank %}
              <img class="ai-reviews-{{ ai_gen_id }}__image" src="{{ review_image | image_url: width: 900 }}" alt="{{ review_image.alt | default: review_name | escape }}" loading="lazy" width="{{ review_image.width }}" height="{{ review_image.height }}">
            {% endif %}
            <div class="ai-reviews-{{ ai_gen_id }}__body">
              {% if review_name != blank %}<h3>{{ review_name | escape }}</h3>{% endif %}
              {% if review_quote != blank %}<p class="ai-reviews-{{ ai_gen_id }}__quote">{{ review_quote | escape }}</p>{% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
      {% if visible_reviews == 0 %}<div class="ai-reviews-{{ ai_gen_id }}__empty">Add genuine customer feedback, names, and optional photos in the block settings.</div>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "header", "content": "Section content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer feedback" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer experiences." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Share verified feedback from your customers." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Review 1" },
    { "type": "image_picker", "id": "review_1_image", "label": "Customer image" },
    { "type": "text", "id": "review_1_name", "label": "Customer name" },
    { "type": "textarea", "id": "review_1_quote", "label": "Feedback" },
    { "type": "header", "content": "Review 2" },
    { "type": "image_picker", "id": "review_2_image", "label": "Customer image" },
    { "type": "text", "id": "review_2_name", "label": "Customer name" },
    { "type": "textarea", "id": "review_2_quote", "label": "Feedback" },
    { "type": "header", "content": "Review 3" },
    { "type": "image_picker", "id": "review_3_image", "label": "Customer image" },
    { "type": "text", "id": "review_3_name", "label": "Customer name" },
    { "type": "textarea", "id": "review_3_quote", "label": "Feedback" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#222222" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#D8D8D8" },
    { "type": "color", "id": "accent_color", "label": "Eyebrow", "default": "#5C3D4F" }
  ],
  "presets": [
    { "name": "Customer reviews" }
  ],
  "tag": null,
  "class": "customer-reviews-block"
}
{% endschema %}