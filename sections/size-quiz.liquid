{%- comment -%}
  "Find your size" pop-up: waist/hip measurements (or usual jeans size) → recommended size from the
  size blocks below, plus a welcome code for subscribers. Shows once per visitor after a delay; on
  desktop a one-time leaving offer can appear for visitors who haven't claimed a code.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign shop_url = routes.all_products_collection_url
  # Metric (cm) everywhere except the UK, where clothes are usually measured in inches.
  assign metric = true
  if localization.country.iso_code == 'GB'
    assign metric = false
  endif
  if metric
    assign waist_example = '81'
    assign hips_example = '102'
  else
    assign waist_example = '32'
    assign hips_example = '40'
  endif
  if s.product != blank
    assign shop_url = s.product.url
  endif
-%}
{%- if s.enabled and template.name != 'cart' and section.blocks.size > 0 -%}
<div class="spin quiz" data-quiz hidden
  data-delay="{{ s.delay }}" data-mobile="{{ s.show_on_mobile }}" data-design="{{ request.design_mode }}"
  data-code="{{ s.code | escape }}" data-offer="{{ s.offer_label | escape }}"
  data-leave="{{ s.leave_enabled }}" data-leave-code="{{ s.leave_code | escape }}" data-leave-offer="{{ s.leave_label | escape }}"
  data-leave-heading="{{ s.leave_heading | escape }}" data-leave-text="{{ s.leave_text | escape }}"
  data-shop-url="{{ shop_url }}"
  role="dialog" aria-modal="true" aria-labelledby="QuizTitle-{{ section.id }}">
  <script type="application/json" data-quiz-sizes>
    [{%- for block in section.blocks -%}{"name": {{ block.settings.name | json }}, "waist": {{ block.settings.waist_max | default: 0 }}, "hips": {{ block.settings.hips_max | default: 0 }}, "us": {{ block.settings.us | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
  </script>
  <div class="spin__backdrop" data-quiz-close></div>
  <div class="spin__panel quiz__panel">
    <button type="button" class="spin__close" data-quiz-close aria-label="{{ 'general.close' | t }}">×</button>
    <div class="quiz__art" aria-hidden="true">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: '', data-quiz-art: 'welcome' }}
      {%- else -%}
        <img src="{{ 'blkm-duo.webp' | asset_url }}" alt="" width="700" height="700" loading="lazy" data-quiz-art="welcome">
      {%- endif -%}
      {%- if s.leave_image != blank -%}
        {{ s.leave_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: '', data-quiz-art: 'leave', hidden: true }}
      {%- endif -%}
    </div>

    <div class="spin__body quiz__body">
      <div data-quiz-step="start">
        {%- if s.eyebrow != blank -%}<p class="spin__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="spin__title" id="QuizTitle-{{ section.id }}" data-quiz-heading>{{ s.heading | escape }}</h2>
        <p class="spin__text" data-quiz-text>{{ s.text | escape }}</p>
        <div class="quiz__choices">
          <button type="button" class="spin__button" data-quiz-go="measure">{{ 'quiz.measurements_button' | t }}</button>
          <button type="button" class="quiz__outline" data-quiz-go="jeans">{{ 'quiz.jeans_button' | t }}</button>
        </div>
        <button type="button" class="spin__skip" data-quiz-close>{{ s.decline_label | escape }}</button>
      </div>

      <form data-quiz-step="measure" class="quiz__step" hidden novalidate>
        <p class="spin__eyebrow">{{ 'quiz.step_1' | t }}</p>
        <h2 class="spin__title">{{ 'quiz.measurements_title' | t }}</h2>
        <div class="quiz__units" role="radiogroup" aria-label="{{ 'quiz.units' | t }}">
          <label><input type="radio" name="unit" value="in"{% unless metric %} checked{% endunless %}> {{ 'quiz.inches' | t }}</label>
          <label><input type="radio" name="unit" value="cm"{% if metric %} checked{% endif %}> {{ 'quiz.cm' | t }}</label>
        </div>
        <label class="quiz__field">{{ 'quiz.waist' | t }} <small>{{ 'quiz.waist_hint' | t }}</small>
          <input type="number" name="waist" inputmode="decimal" step="0.5" min="1" placeholder="{{ 'quiz.example' | t | replace: '[value]', waist_example }}">
        </label>
        <label class="quiz__field">{{ 'quiz.hips' | t }} <small>{{ 'quiz.hips_hint' | t }}</small>
          <input type="number" name="hips" inputmode="decimal" step="0.5" min="1" placeholder="{{ 'quiz.example' | t | replace: '[value]', hips_example }}">
        </label>
        <p class="quiz__error" data-quiz-error role="alert" hidden></p>
        <button type="submit" class="spin__button">{{ 'quiz.next' | t }}</button>
        <button type="button" class="spin__skip" data-quiz-go="start">{{ 'quiz.back' | t }}</button>
      </form>

      <form data-quiz-step="jeans" class="quiz__step" hidden>
        <p class="spin__eyebrow">{{ 'quiz.step_1' | t }}</p>
        <h2 class="spin__title">{{ 'quiz.jeans_title' | t }}</h2>
        <label class="quiz__field">{{ 'quiz.jeans_label' | t }}
          <select name="jeans" required>
            {%- for block in section.blocks -%}
              {%- if block.settings.us != blank -%}<option value="{{ forloop.index0 }}">{{ block.settings.us | escape }}</option>{%- endif -%}
            {%- endfor -%}
          </select>
        </label>
        <p class="spin__fine">{{ 'quiz.jeans_note' | t }}</p>
        <button type="submit" class="spin__button">{{ 'quiz.next' | t }}</button>
        <button type="button" class="spin__skip" data-quiz-go="start">{{ 'quiz.back' | t }}</button>
      </form>

      <div data-quiz-step="email" hidden>
        <p class="spin__eyebrow">{{ 'quiz.step_2' | t }}</p>
        <h2 class="spin__title">{{ 'quiz.size_ready' | t }}</h2>
        <p class="spin__text" data-quiz-email-text>{{ 'quiz.email_text' | t | replace: '[offer]', '<strong data-quiz-offer></strong>' }}</p>
        {%- form 'customer', class: 'spin__form quiz__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,size-quiz">
          <label class="visually-hidden" for="QuizEmail-{{ section.id }}">{{ 'quiz.email' | t }}</label>
          <input id="QuizEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ s.email_placeholder | escape }}" required>
          <button type="submit" class="spin__button">{{ s.button_label | escape }}</button>
        {%- endform -%}
        {%- if s.consent != blank -%}<p class="spin__fine">{{ s.consent | escape }}</p>{%- endif -%}
        <button type="button" class="spin__skip" data-quiz-skip-email>{{ 'quiz.skip_email' | t }}</button>
      </div>

      <div data-quiz-step="result" hidden>
        <p class="spin__eyebrow">{{ 'quiz.your_size' | t }}</p>
        <p class="quiz__size" data-quiz-size></p>
        <p class="spin__text" data-quiz-note></p>
        <div data-quiz-code-wrap hidden>
          <p class="spin__fine quiz__code-label">{{ 'quiz.your_code' | t | replace: '[offer]', '<span data-quiz-offer></span>' }}</p>
          <div class="spin__code"><span data-quiz-code></span><button type="button" data-quiz-copy>{{ 'quiz.copy' | t }}</button></div>
        </div>
        <a class="spin__button quiz__shop" data-quiz-shop href="{{ shop_url }}">{{ 'quiz.shop_my_size' | t }}</a>
        <button type="button" class="spin__skip" data-quiz-go="start">{{ 'quiz.start_over' | t }}</button>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Size quiz pop-up",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show pop-up", "default": true },
    { "type": "range", "id": "delay", "label": "Show after", "min": 2, "max": 60, "step": 1, "unit": "s", "default": 8 },
    { "type": "checkbox", "id": "show_on_mobile", "label": "Show on phones", "default": true },
    { "type": "product", "id": "product", "label": "Product for “Shop my size”" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown on computers only." },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BLK_MAJESTY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your perfect size" },
    { "type": "text", "id": "text", "label": "Text", "default": "2 quick questions — get your size and 10% off your first order." },
    { "type": "text", "id": "decline_label", "label": "Decline link", "default": "No thanks" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Email button", "default": "SHOW MY SIZE" },
    { "type": "text", "id": "consent", "label": "Consent note", "default": "By entering your email you agree to receive BLK_MAJESTY emails. Unsubscribe anytime." },
    { "type": "header", "content": "Welcome offer" },
    { "type": "paragraph", "content": "Create the code first in Shopify → Discounts." },
    { "type": "text", "id": "offer_label", "label": "Offer", "default": "10% off" },
    { "type": "text", "id": "code", "label": "Discount code", "default": "FIT10" },
    { "type": "header", "content": "Leaving offer" },
    { "type": "checkbox", "id": "leave_enabled", "label": "Show a better offer when a visitor moves to leave", "default": true, "info": "Computers: when the mouse moves to leave. Phones (after 20s on a page): a fast scroll back up, or coming back from another tab or app. Only for visitors without a code; shows once." },
    { "type": "image_picker", "id": "leave_image", "label": "Image for the leaving offer", "info": "Empty uses the main image." },
    { "type": "text", "id": "leave_label", "label": "Offer", "default": "15% off" },
    { "type": "text", "id": "leave_code", "label": "Discount code", "default": "STAY15" },
    { "type": "text", "id": "leave_heading", "label": "Heading", "default": "Wait — find your size + get 15% off" },
    { "type": "text", "id": "leave_text", "label": "Text", "default": "2 quick questions before you go — get your size and 15% off your first order." }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size",
      "limit": 12,
      "settings": [
        { "type": "paragraph", "content": "Add sizes from smallest to largest. Measurements in cm, from your size chart. A measurement between two sizes gets the larger size." },
        { "type": "text", "id": "name", "label": "Size name", "default": "M", "info": "Must match the product's Size option (e.g. 2XL)." },
        { "type": "number", "id": "waist_max", "label": "Largest waist for this size (cm)", "default": 81 },
        { "type": "number", "id": "hips_max", "label": "Largest hips for this size (cm)", "default": 97 },
        { "type": "text", "id": "us", "label": "Usual US jeans size", "default": "2–4" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size quiz pop-up",
      "blocks": [
        { "type": "size", "settings": { "name": "S", "waist_max": 74, "hips_max": 91, "us": "0" } },
        { "type": "size", "settings": { "name": "M", "waist_max": 81, "hips_max": 97, "us": "2–4" } },
        { "type": "size", "settings": { "name": "L", "waist_max": 94, "hips_max": 104, "us": "6–8" } },
        { "type": "size", "settings": { "name": "XL", "waist_max": 104, "hips_max": 112, "us": "10–12" } },
        { "type": "size", "settings": { "name": "2XL", "waist_max": 112, "hips_max": 119, "us": "14–16" } },
        { "type": "size", "settings": { "name": "3XL", "waist_max": 118, "hips_max": 124, "us": "18–20" } }
      ]
    }
  ]
}
{% endschema %}
