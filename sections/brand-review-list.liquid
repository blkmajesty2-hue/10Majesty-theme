{% liquid
  assign count = section.blocks.size
  assign total = 0
  for block in section.blocks
    assign total = total | plus: block.settings.rating
  endfor
  assign form_id = 'ReviewForm-' | append: section.id
  assign details_id = 'ReviewDetails-' | append: section.id
%}
<section class="bm-review-section" id="blk-reviews">
  <div class="bm-review-wrap">
    <h2>{{ section.settings.heading | escape }}</h2>
    <div class="bm-review-summary">
      <div class="bm-review-total">
        {% if count > 0 %}<strong>{{ total | times: 1.0 | divided_by: count | round: 1 }}<span>/5</span></strong>{% else %}<strong>—<span>/5</span></strong>{% endif %}
        <div class="bm-review-stars" aria-hidden="true">☆☆☆☆☆</div>
        <p>{{ 'brand_reviews.count' | t: count: count }}</p>
      </div>
      <div class="bm-review-bars">
        {% for rating in (1..5) reversed %}
          {% liquid
            assign amount = 0
            for block in section.blocks
              if block.settings.rating == rating
                assign amount = amount | plus: 1
              endif
            endfor
            assign percent = 0
            if count > 0
              assign percent = amount | times: 100.0 | divided_by: count | round
            endif
          %}
          <div class="bm-review-bar-row"><span>{{ rating }} <span class="bm-review-stars" aria-hidden="true">★</span></span><span class="bm-review-bar"><span style="width: {{ percent }}%"></span></span><span>{{ percent }}%</span><span>({{ amount }})</span></div>
        {% endfor %}
      </div>
      <a class="bm-review-link" data-open-review href="#{{ details_id }}">{{ 'brand_reviews.write' | t }}</a>
    </div>
    {% if count == 0 %}<p class="bm-review-empty">{{ 'brand_reviews.empty' | t }}</p>{% endif %}
    <details class="bm-review-form" id="{{ details_id }}">
      <summary>{{ 'brand_reviews.write' | t }}</summary>
      {% form 'contact', id: form_id %}
        {% if form.posted_successfully? %}<p role="status" data-review-feedback>{{ 'brand_reviews.success' | t }}</p>{% else %}
          {% if form.errors %}<div role="alert" data-review-feedback>{{ form.errors | default_errors }}</div>{% endif %}
          <input type="hidden" name="contact[subject]" value="BLK_Majesty product review">
          <input type="hidden" name="contact[product]" value="{{ product.title | escape }}">
          <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">
          <div class="bm-review-fields">
            <div><label for="Name-{{ section.id }}">{{ 'brand_reviews.name' | t }}</label><input id="Name-{{ section.id }}" name="contact[name]" autocomplete="name" required maxlength="100" value="{{ form.name | escape }}"></div>
            <div><label for="Email-{{ section.id }}">{{ 'brand_reviews.email' | t }}</label><input id="Email-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email | escape }}"></div>
          </div>
          <label for="Rating-{{ section.id }}">{{ 'brand_reviews.rating' | t }}</label>
          <select id="Rating-{{ section.id }}" name="contact[rating]" required><option value="">{{ 'brand_reviews.choose' | t }}</option>{% for rating in (1..5) reversed %}<option value="{{ rating }}">{{ rating }} / 5</option>{% endfor %}</select>
          <label for="Body-{{ section.id }}">{{ 'brand_reviews.review' | t }}</label>
          <textarea id="Body-{{ section.id }}" name="contact[body]" rows="5" required minlength="5" maxlength="5000">{{ form.body | escape }}</textarea>
          <p class="bm-review-caption">{{ 'brand_reviews.note' | t }}</p>
          <button type="submit" class="bm-review-link">{{ 'brand_reviews.send' | t }}</button>
        {% endif %}
      {% endform %}
    </details>
    <div class="bm-review-list">
      {% for block in section.blocks %}
        <article class="bm-review-item" {{ block.shopify_attributes }}>
          <div class="bm-review-person"><span class="bm-review-avatar" aria-hidden="true">{{ block.settings.author | slice: 0 | escape }}</span><strong>{{ block.settings.author | escape }}</strong></div>
          <div class="bm-review-body"><div class="bm-review-stars" aria-label="{{ 'brand_reviews.stars' | t: score: block.settings.rating }}">{% for star in (1..5) %}{% if star <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}</div><p>{{ block.settings.text | escape }}</p></div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% stylesheet %}

.bm-review-section{background:#fff;color:#171717;padding:64px 0;font-family:inherit}
.bm-review-wrap{width:min(1200px,calc(100% - 40px));margin:auto}
.bm-review-section h2{text-align:center;font-size:clamp(28px,3vw,40px);line-height:1.2;letter-spacing:-.02em;margin:0 0 12px}
.bm-review-source{text-align:center;font-size:14px;line-height:1.6;color:#626262;margin:0 auto 32px;max-width:750px}
.bm-review-source a{color:inherit;text-decoration:underline}
.bm-review-summary{display:grid;grid-template-columns:1fr 1.4fr 1fr;align-items:center;gap:32px;padding:24px 0 32px;border-bottom:1px solid #dedede}
.bm-review-total{text-align:center}
.bm-review-total>strong{font-size:48px;line-height:1.2;letter-spacing:-.04em}
.bm-review-total>strong span{font-size:20px;letter-spacing:0;color:#666}
.bm-review-stars{color:#dd981f;letter-spacing:2px;font-size:20px;line-height:1.4}
.bm-review-total p{font-size:14px;margin:8px 0 0}
.bm-review-bars{border-inline:1px solid #e6e6e6;padding:0 28px}
.bm-review-bar-row{display:grid;grid-template-columns:36px 1fr 36px 46px;align-items:center;gap:8px;font-size:12px;margin:6px 0;font-variant-numeric:tabular-nums}
.bm-review-bar-row .bm-review-stars{font-size:15px}
.bm-review-bar{height:10px;background:#eee;overflow:hidden}
.bm-review-bar>span{height:100%;display:block;background:#171717}
.bm-review-link{display:block;text-align:center;padding:14px 18px;background:#111;color:#fff;text-decoration:none;font-size:14px;border-radius:4px}
.bm-review-link:hover{background:#353535}
.bm-review-link:focus-visible,.bm-review-source a:focus-visible{outline:3px solid #986100;outline-offset:4px}
.bm-review-caption{font-size:13px;color:#666;margin:22px 0}
.bm-review-item{display:grid;grid-template-columns:240px minmax(0,1fr);gap:24px;padding:24px 0;border-top:1px solid #e4e4e4}
.bm-review-person{display:flex;align-items:center;gap:12px;align-self:start;font-size:15px}
.bm-review-avatar{display:grid;place-items:center;flex:0 0 40px;height:40px;border-radius:50%;background:#f2efeb;color:#444;font-size:16px}
.bm-review-body p{font-size:16px;line-height:1.6;margin:10px 0;letter-spacing:0}
.bm-review-body small{font-size:12px;color:#666}
@media(max-width:749px){.bm-review-section{padding:40px 0}.bm-review-wrap{width:calc(100% - 32px)}.bm-review-summary{grid-template-columns:1fr;gap:22px;padding-top:8px}.bm-review-bars{border:0;padding:0;max-width:400px;width:100%;margin:auto}.bm-review-link{max-width:400px;width:100%;box-sizing:border-box;margin:auto}.bm-review-item{grid-template-columns:1fr;gap:12px;padding:22px 0}.bm-review-source{font-size:13px;margin-bottom:20px}.bm-review-body p{font-size:15px}.bm-review-caption{line-height:1.6}}

.bm-review-empty{text-align:center;color:#666;padding:24px 0;font-size:16px}
.bm-review-form{max-width:760px;margin:24px auto;border:1px solid #dedede;border-radius:8px;padding:20px;scroll-margin-top:100px}
.bm-review-form summary{cursor:pointer;font-weight:600;font-size:16px}
.bm-review-form form{padding-top:20px}
.bm-review-fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.bm-review-form label{display:block;margin:14px 0 7px;font-size:14px}
.bm-review-form input,.bm-review-form textarea,.bm-review-form select{box-sizing:border-box;width:100%;padding:12px;border:1px solid #aaa;border-radius:4px;background:#fff;color:#111;font:inherit;font-size:16px}
.bm-review-form textarea{resize:vertical}
.bm-review-form button{border:0;cursor:pointer;font-family:inherit;min-height:48px}
.bm-review-form :focus-visible{outline:2px solid #111;outline-offset:3px}
.bm-review-form .bm-review-caption{line-height:1.6}
@media(max-width:749px){.bm-review-fields{grid-template-columns:1fr;gap:0}.bm-review-form{padding:16px}}
{% endstylesheet %}
{% javascript %}
function setupBrandReviews(root) {
  root.querySelectorAll('.bm-review-section').forEach(section => {
    const details = section.querySelector('.bm-review-form');
    const trigger = section.querySelector('[data-open-review]');
    if (!details || !trigger || trigger.dataset.ready) return;
    trigger.dataset.ready = 'true';
    trigger.addEventListener('click', event => {
      event.preventDefault();
      details.open = true;
      details.scrollIntoView({block:'start', behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});
      const input = details.querySelector('input:not([type="hidden"])');
      if (input) input.focus({preventScroll:true});
    });
    if(details.querySelector('[data-review-feedback]')) {
      details.open = true;
      details.scrollIntoView({block:'start'});
    }
  });
}
setupBrandReviews(document);
document.addEventListener('shopify:section:load', event => setupBrandReviews(event.target));
{% endjavascript %}
{% schema %}
{"name":"BLK Majesty reviews","settings":[{"type":"text","id":"heading","label":"Rubrik","default":"BLK_Majesty – kundomdömen"}],"blocks":[{"type":"review","name":"Kundomdöme","settings":[{"type":"text","id":"author","label":"Kundens namn"},{"type":"range","id":"rating","label":"Betyg","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"text","label":"Omdöme"}]}],"presets":[{"name":"BLK Majesty reviews"}]}
{% endschema %}
