<div class="password-page">
  <div>
    <p class="wordmark">{{ shop.name | upcase }}</p>
    <h1>{{ 'general.password.opening_soon' | t }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'demo-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="email-row">
        <input type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.label' | t }}" required>
        <button class="primary" type="submit">{{ 'newsletter.button' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}<p class="form-status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
    {%- endform -%}
    <details>
      <summary>{{ 'general.password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <input type="password" name="password" aria-label="{{ 'general.password.password' | t }}" placeholder="{{ 'general.password.password' | t }}">
        <button class="primary" type="submit">{{ 'general.password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{ "name": "Password" }
{% endschema %}
