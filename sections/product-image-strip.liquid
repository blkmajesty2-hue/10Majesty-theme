{%- liquid
  assign fallback = 'blkm-duo.webp,blkm-details-black.webp,blkm-details-beige.webp,blkm-closer-look.webp,blkm-blue.webp' | split: ','
-%}
<section class="product-film">
  <div class="wrap">
    <div class="film-track">
      {%- if product and product.media.size > 0 -%}
        {%- for media in product.media -%}
          {{ media.preview_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
        {%- endfor -%}
      {%- else -%}
        {%- for file in fallback -%}
          <img src="{{ file | asset_url }}" alt="" width="185" height="185" loading="lazy">
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="reference-rating" role="group" aria-label="Reference-store rating: 4.8 out of 5">
      <span class="reference-rating__stars" aria-hidden="true">★★★★★</span>
      <strong>4.8/5</strong>
      <span class="reference-rating__label">Reference-store rating</span>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .reference-rating {
    display:flex; align-items:center; gap:20px; margin-top:38px; padding:26px 28px;
    border:1px solid #d8d8d8; border-radius:22px; background:#f5f5f5; color:#000;
  }
  #shopify-section-{{ section.id }} .reference-rating__stars { font-size:29px; line-height:1; letter-spacing:2px; white-space:nowrap; }
  #shopify-section-{{ section.id }} .reference-rating strong { font-size:27px; line-height:1; white-space:nowrap; }
  #shopify-section-{{ section.id }} .reference-rating__label { color:#777; font-size:22px; line-height:1.2; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .reference-rating { gap:10px; margin-top:24px; padding:18px 16px; border-radius:16px; }
    #shopify-section-{{ section.id }} .reference-rating__stars { font-size:18px; letter-spacing:0; }
    #shopify-section-{{ section.id }} .reference-rating strong { font-size:18px; }
    #shopify-section-{{ section.id }} .reference-rating__label { font-size:15px; }
  }
  @media (max-width: 380px) {
    #shopify-section-{{ section.id }} .reference-rating { flex-wrap:wrap; }
    #shopify-section-{{ section.id }} .reference-rating__label { flex-basis:100%; }
  }
</style>

{% schema %}
{
  "name": "Product image strip",
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Product image strip" }]
}
{% endschema %}