{%- comment -%}
  Spin-to-win pop-up. Every spin wins the same offer (the wheel says so), so there are no fake odds.
  Shows once per visitor after a delay; on desktop a better "leaving" offer appears when the
  visitor moves to leave without having claimed a code. Codes must exist in Shopify → Discounts.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign wheel_offer = s.offer_label
  assign slices = 8
-%}
{%- if s.enabled and template.name != 'cart' -%}
<div class="spin" data-spin hidden
  data-delay="{{ s.delay }}"
  data-mobile="{{ s.show_on_mobile }}"
  data-leave="{{ s.leave_enabled }}"
  data-design="{{ request.design_mode }}"
  data-offer="{{ s.offer_label | escape }}" data-code="{{ s.code | escape }}"
  data-leave-offer="{{ s.leave_label | escape }}" data-leave-code="{{ s.leave_code | escape }}"
  data-leave-heading="{{ s.leave_heading | escape }}" data-leave-text="{{ s.leave_text | escape }}"
  role="dialog" aria-modal="true" aria-labelledby="SpinTitle-{{ section.id }}">
  <div class="spin__backdrop" data-spin-close></div>
  <div class="spin__panel">
    <button type="button" class="spin__close" data-spin-close aria-label="{{ 'general.close' | t }}">×</button>
    <div class="spin__wheel-wrap" aria-hidden="true">
      <span class="spin__pointer"></span>
      <svg class="spin__wheel" data-spin-wheel viewBox="-100 -100 200 200">
        {%- for i in (1..slices) -%}
          {%- liquid
            assign k = i | minus: 1
            assign a1 = k | times: 45 | minus: 90
            assign mid = a1 | plus: 22.5
            assign odd = k | modulo: 2
          -%}
          <g transform="rotate({{ a1 }})">
            <path d="M0 0 L95 0 A95 95 0 0 1 67.175 67.175 Z" fill="{% if odd == 0 %}#0a0a0a{% else %}#ffffff{% endif %}"/>
          </g>
          <text transform="rotate({{ mid }}) translate(60 0)" class="spin__label {% if odd == 0 %}is-light{% else %}is-dark{% endif %}" data-spin-label>{{ wheel_offer | escape }}</text>
        {%- endfor -%}
        <circle r="95" fill="none" stroke="#0a0a0a" stroke-width="3"/>
        <circle r="17" fill="#0a0a0a" stroke="#fff" stroke-width="3"/>
        <text class="spin__hub" y="4">BLK</text>
      </svg>
    </div>

    <div class="spin__body">
      <div data-spin-step="form">
        {%- if s.eyebrow != blank -%}<p class="spin__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="spin__title" id="SpinTitle-{{ section.id }}" data-spin-heading>{{ s.heading | escape }}</h2>
        <p class="spin__text" data-spin-text>{{ s.text | escape }}</p>
        {%- form 'customer', class: 'spin__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,spin-wheel">
          <label class="visually-hidden" for="SpinEmail-{{ section.id }}">Email</label>
          <input id="SpinEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ s.email_placeholder | escape }}" required>
          <button type="submit" class="spin__button" data-spin-submit>{{ s.button_label | escape }}</button>
        {%- endform -%}
        {%- if s.consent != blank -%}<p class="spin__fine">{{ s.consent | escape }}</p>{%- endif -%}
        <button type="button" class="spin__skip" data-spin-close>{{ s.decline_label | escape }}</button>
      </div>

      <div data-spin-step="won" hidden>
        <p class="spin__eyebrow">{{ s.win_eyebrow | escape }}</p>
        <h2 class="spin__title"><span data-spin-won-offer></span></h2>
        <p class="spin__text">{{ s.win_text | escape }}</p>
        <div class="spin__code">
          <span data-spin-won-code></span>
          <button type="button" data-spin-copy>Copy</button>
        </div>
        <button type="button" class="spin__button" data-spin-apply>{{ s.apply_label | escape }}</button>
        <p class="spin__fine" data-spin-applied hidden>✓ Code saved — it will be applied at checkout.</p>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Spin-to-win pop-up",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show pop-up", "default": true },
    { "type": "range", "id": "delay", "label": "Show after", "min": 2, "max": 60, "step": 1, "unit": "s", "default": 8 },
    { "type": "checkbox", "id": "show_on_mobile", "label": "Show on phones", "default": true },
    { "type": "header", "content": "Wheel offer" },
    { "type": "paragraph", "content": "Every spin wins this offer. Create the code first in Shopify → Discounts." },
    { "type": "text", "id": "offer_label", "label": "Offer shown on the wheel", "default": "10% OFF" },
    { "type": "text", "id": "code", "label": "Discount code", "default": "SPIN10" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BLK_MAJESTY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spin to unlock your discount" },
    { "type": "text", "id": "text", "label": "Text", "default": "Every spin wins 10% off your first order. Enter your email to spin." },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Spin button", "default": "SPIN THE WHEEL" },
    { "type": "text", "id": "consent", "label": "Consent note", "default": "By entering your email you agree to receive BLK_MAJESTY emails. Unsubscribe anytime." },
    { "type": "text", "id": "decline_label", "label": "Decline link", "default": "No thanks" },
    { "type": "header", "content": "After the spin" },
    { "type": "text", "id": "win_eyebrow", "label": "Eyebrow", "default": "YOU WON" },
    { "type": "text", "id": "win_text", "label": "Text", "default": "Use this code at checkout. One use per customer." },
    { "type": "text", "id": "apply_label", "label": "Apply button", "default": "APPLY & SHOP" },
    { "type": "header", "content": "Leaving offer (desktop)" },
    { "type": "checkbox", "id": "leave_enabled", "label": "Show a better offer when a visitor moves to leave", "default": true, "info": "Only for visitors who haven't claimed a code yet. Shows once." },
    { "type": "text", "id": "leave_label", "label": "Offer shown on the wheel", "default": "15% OFF" },
    { "type": "text", "id": "leave_code", "label": "Discount code", "default": "STAY15" },
    { "type": "text", "id": "leave_heading", "label": "Heading", "default": "Wait — take 15% off before you go" },
    { "type": "text", "id": "leave_text", "label": "Text", "default": "Every spin wins 15% off your first order. Enter your email to spin." }
  ]
}
{% endschema %}
