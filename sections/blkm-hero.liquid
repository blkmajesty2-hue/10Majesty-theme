<section class="wrap home-hero">
  <div class="hero-copy">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1>{{ section.settings.heading | newline_to_br }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.offer_title != blank -%}
      <div class="hero-offer"><b>{{ section.settings.offer_title | escape }}</b><span>{{ section.settings.offer_text | escape }}</span></div>
    {%- endif -%}
  </div>
  <div class="hero-photo">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(max-width: 760px) 100vw, 55vw', widths: '600, 900, 1200, 1400' }}
    {%- else -%}
      <img src="{{ 'blkm-duo.webp' | asset_url }}" alt="{{ shop.name }} high-waist shaping briefs in black and beige" width="1254" height="1254" fetchpriority="high">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BLK_MAJESTY shapewear" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Your everyday\nfoundation." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "High-waist shaping briefs with an X-shaped cross-over front, made to sit smoothly beneath everything you wear." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the shaping briefs" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "offer_title", "label": "Offer title", "default": "Buy 2, get 2 free" },
    { "type": "text", "id": "offer_text", "label": "Offer text", "default": "Sizes S–3XL · Mix and match colors" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the built-in product photo." }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
