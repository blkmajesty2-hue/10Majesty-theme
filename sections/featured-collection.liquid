{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections.all
  endif
-%}
<section class="wrap collection" id="collection">
  <div class="section-heading">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <p><a class="text-link" href="{{ collection.url }}">{{ 'general.view_all' | t }}</a></p>
  </div>
  <div class="product-grid{% if section.settings.columns == '4' %} four{% endif %}">
    {%- for product in collection.products limit: section.settings.limit -%}
      {%- render 'product-card', product: product -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        <article class="product-card">
          <div class="card-image">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          <h3>{{ 'general.product_title' | t }}</h3>
          <div class="price">{{ 2990 | money }}</div>
        </article>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop BLK_MAJESTY." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }] }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
