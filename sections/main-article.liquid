<article class="page-width-narrow">
  <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
  <h1>{{ article.title | escape }}</h1>
  {%- if article.image -%}{{ article.image | image_url: width: 1400 | image_tag: alt: article.title }}{%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p><a class="text-link" href="{{ blog.url }}">{{ 'blogs.back' | t: title: blog.title }}</a></p>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
