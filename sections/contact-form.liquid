<section class="contact-section" id="contact">
  <div class="wrap contact-grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    {%- form 'contact', class: 'contact-form', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="two">
        <label>{{ 'contact.name' | t }}<input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required></label>
        <label>{{ 'contact.email' | t }}<input type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required></label>
      </div>
      <label>{{ 'contact.order' | t }}<input type="text" name="contact[order]"></label>
      <label>{{ 'contact.message' | t }}<textarea name="contact[body]" rows="5" required>{{ form.body }}</textarea></label>
      <button class="primary" type="submit">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about sizing, bundles or delivery? Send a message and the BLK_MAJESTY team will get back to you.</p>" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
