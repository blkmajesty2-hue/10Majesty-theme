<section class="blkm-reviews" id="reviews-{{ section.id }}">
  <div class="blkm-reviews__wrap">
    <div class="blkm-reviews__heading">
      <div>
        <p class="blkm-reviews__eyebrow">From the reference store</p>
        <h2>Customer experiences.</h2>
      </div>
      <p class="blkm-reviews__intro">Source reports 6,000+ customers.<br>English summaries, not verbatim reviews.</p>
    </div>

    <div class="blkm-reviews__track">
      {% assign review_names = 'Chiara, 44|Alessandra, 49|Cristina, 52|Valentina, 47|Serena, 56|Giorgia, 34|Martina, 38|Paola, 57|Rosa, 63' | split: '|' %}
      {% assign review_texts = 'Describes feeling more comfortable in her jeans with the wraparound support.|Highlights the fit and ease of wearing the brief throughout the day.|Focuses on the cross-band feel while sitting, standing and moving.|Values the defined waist and how easily the brief fits into her routine.|Describes feeling more confident getting dressed for a special dinner.|Shares how the high-waist silhouette looked beneath a dress.|Discusses a smoother appearance beneath fitted clothing.|Describes wearing a favorite dress to a family wedding.|Focuses on comfort and enjoying a family occasion without fuss.' | split: '|' %}

      {% for review_name in review_names %}
        {% assign image_number = forloop.index %}
        {% if image_number == 9 %}{% assign image_number = 1 %}{% endif %}
        {% assign filename = 'belayan-review-' | append: image_number | append: '.webp' %}
        <article class="blkm-review">
          <div class="blkm-review__image-wrap">
            <img
              src="{{ filename | file_url }}"
              alt="Reference customer image: {{ review_name }}"
              class="blkm-review__image"
              width="720"
              height="900"
              loading="lazy"
            >
          </div>
          <div class="blkm-review__body">
            <span class="blkm-review__stars" aria-label="5 out of 5 stars">★★★★★</span>
            <h3>{{ review_name }}</h3>
            <p>{{ review_texts[forloop.index0] }}</p>
            <small>Summary of a source-store testimonial</small>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .blkm-reviews { background:#fff; color:#080808; padding:clamp(64px,9vw,120px) 0; overflow:hidden; }
  .blkm-reviews * { box-sizing:border-box; }
  .blkm-reviews__wrap { width:min(1440px,100%); margin:0 auto; padding:0 clamp(20px,4vw,64px); }
  .blkm-reviews__heading { display:flex; align-items:flex-end; justify-content:space-between; gap:40px; margin-bottom:46px; border-bottom:1px solid #d8d8d8; padding-bottom:30px; }
  .blkm-reviews__eyebrow { margin:0 0 12px; font:700 12px/1.2 Arial,sans-serif; letter-spacing:.16em; text-transform:uppercase; }
  .blkm-reviews__heading h2 { margin:0; font:800 clamp(40px,6vw,76px)/.96 Arial,sans-serif; letter-spacing:-.055em; }
  .blkm-reviews__intro { margin:0; max-width:390px; color:#666; font:400 16px/1.55 Arial,sans-serif; }
  .blkm-reviews__track { display:grid; grid-auto-flow:column; grid-auto-columns:minmax(300px,31vw); gap:18px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:thin; scrollbar-color:#111 #eee; padding:0 0 24px; }
  .blkm-review { scroll-snap-align:start; background:#f3f3f3; border:1px solid #dedede; border-radius:18px; overflow:hidden; min-height:100%; }
  .blkm-review__image-wrap { aspect-ratio:4/5; background:#e9e9e9; overflow:hidden; }
  .blkm-review__image { width:100%; height:100%; object-fit:cover; display:block; transition:transform .55s ease; }
  .blkm-review:hover .blkm-review__image { transform:scale(1.025); }
  .blkm-review__body { padding:24px 24px 28px; }
  .blkm-review__stars { display:block; margin-bottom:14px; font-size:19px; line-height:1; letter-spacing:.08em; }
  .blkm-review h3 { margin:0 0 10px; font:800 25px/1.05 Arial,sans-serif; letter-spacing:-.025em; }
  .blkm-review p { margin:0 0 20px; min-height:4.7em; color:#292929; font:400 16px/1.55 Arial,sans-serif; }
  .blkm-review small { color:#777; font:500 11px/1.4 Arial,sans-serif; letter-spacing:.04em; text-transform:uppercase; }
  @media (max-width:749px) {
    .blkm-reviews { padding:58px 0; }
    .blkm-reviews__wrap { padding:0 18px; }
    .blkm-reviews__heading { display:block; margin-bottom:28px; padding-bottom:24px; }
    .blkm-reviews__heading h2 { font-size:46px; }
    .blkm-reviews__intro { margin-top:20px; font-size:14px; }
    .blkm-reviews__track { grid-auto-columns:86vw; gap:14px; margin-right:-18px; padding-right:18px; }
    .blkm-review__body { padding:21px 20px 24px; }
    .blkm-review p { min-height:0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer reviews",
  "settings": [],
  "presets": [{ "name": "Customer reviews" }]
}
{% endschema %}
