{%- liquid
  assign reviews = section.blocks | where: 'type', 'review'
  assign photos = section.blocks | where: 'type', 'photo'
-%}
{%- if reviews.size > 0 or photos.size > 0 -%}
  <section class="reviews">
    <div class="wrap">
      <div class="section-heading">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
      {%- if photos.size > 0 -%}
        <div class="review-photos">
          {%- for block in photos -%}
            {%- if block.settings.image != blank -%}
              <figure class="review-photo" {{ block.shopify_attributes }}>
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.caption | default: 'Customer photo' }}
                {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if reviews.size > 0 -%}
        <div class="reviews-track">
          {%- for block in reviews -%}
            <article class="review" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank and block.settings.image_2 != blank -%}
                <div class="review__pics">
                  {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name }}
                  {{ block.settings.image_2 | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name }}
                </div>
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {%- elsif block.settings.image_2 != blank -%}
                {{ block.settings.image_2 | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {%- endif -%}
              <div>
                <span class="stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</span>
                <h3>{{ block.settings.name | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
                {%- if block.settings.verified -%}<small>✓ Verified buyer</small>{%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="wrap"><p class="empty-section-note">Customer reviews: click "Add block" under this section, then choose <b>Review</b> (name, stars, text and up to 2 photos) or <b>Photo</b> (a customer photo on its own). Hidden until you add one.</p></div>
{%- endif -%}

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer experiences." },
    { "type": "paragraph", "content": "Add a Review block for each real customer review (up to 2 photos each), or a Photo block for customer photos without text." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo 1" },
        { "type": "image_picker", "id": "image_2", "label": "Photo 2 (optional)" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review" },
        { "type": "checkbox", "id": "verified", "label": "Show \"Verified buyer\"", "info": "Only tick this for customers who really bought from you.", "default": false }
      ]
    },
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer photo" },
        { "type": "text", "id": "caption", "label": "Caption (optional)", "info": "For example the customer's first name." }
      ]
    }
  ],
  "presets": [{ "name": "Customer reviews" }]
}
{% endschema %}
