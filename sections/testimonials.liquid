{%- if section.blocks.size > 0 -%}
  <section class="reviews">
    <div class="wrap">
      <div class="section-heading">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
      <div class="reviews-track">
        {%- for block in section.blocks -%}
          <article class="review" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.name }}
            {%- endif -%}
            <div>
              <span class="stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</span>
              <h3>{{ block.settings.name | escape }}</h3>
              <p>{{ block.settings.text | escape }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="wrap"><p class="empty-section-note">Customer reviews: add a review block for each real customer review. This section stays hidden until it has at least one.</p></div>
{%- endif -%}

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer experiences." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review" }
      ]
    }
  ],
  "presets": [{ "name": "Customer reviews" }]
}
{% endschema %}
