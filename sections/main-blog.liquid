<div class="wrap collection-header"><h1>{{ blog.title | escape }}</h1></div>
{%- paginate blog.articles by 9 -%}
  <div class="wrap blog-grid">
    {%- for article in blog.articles -%}
      <article>
        {%- if article.image -%}<a href="{{ article.url }}">{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}</a>{%- endif -%}
        <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
        <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
        <a class="text-link" href="{{ article.url }}">{{ 'blogs.read_more' | t }}</a>
      </article>
    {%- endfor -%}
  </div>
  <div class="wrap">{%- render 'pagination', paginate: paginate -%}</div>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog" }
{% endschema %}
