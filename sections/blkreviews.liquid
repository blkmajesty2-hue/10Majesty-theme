<style>
  .blk-reviews {
    padding: 70px 0;
    background: #ffffff;
    color: #111111;
  }

  .blk-reviews__wrap {
    width: min(1200px, calc(100% - 40px));
    margin: 0 auto;
  }

  .blk-reviews__heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin-bottom: 35px;
  }

  .blk-reviews__eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    letter-spacing: 0.18em;
    font-weight: 600;
  }

  .blk-reviews__heading h2 {
    margin: 0;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1;
    font-weight: 500;
  }

  .blk-reviews__intro {
    margin: 0;
    color: #666666;
    font-size: 14px;
    line-height: 1.6;
  }

  .blk-reviews__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .blk-review {
    background: #f7f7f7;
    border: 1px solid #e7e7e7;
    overflow: hidden;
  }

  .blk-review img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 4.6;
    object-fit: cover;
  }

  .blk-review__content {
    padding: 22px;
  }

  .blk-review__stars {
    display: block;
    margin-bottom: 12px;
    font-size: 16px;
    letter-spacing: 2px;
  }

  .blk-review h3 {
    margin: 0 0 10px;
    font-size: 18px;
    font-weight: 600;
  }

  .blk-review p {
    margin: 0 0 16px;
    color: #444444;
    font-size: 14px;
    line-height: 1.6;
  }

  .blk-review small {
    color: #777777;
    font-size: 12px;
  }

  @media screen and (max-width: 900px) {
    .blk-reviews__track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .blk-reviews {
      padding: 45px 0;
    }

    .blk-reviews__wrap {
      width: min(100% - 28px, 1200px);
    }

    .blk-reviews__heading {
      display: block;
    }

    .blk-reviews__intro {
      margin-top: 15px;
    }

    .blk-reviews__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 14px;
      padding-bottom: 12px;
    }

    .blk-review {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }

    .blk-reviews__track::-webkit-scrollbar {
      display: none;
    }
  }
</style>


{% schema %}
{
  "name": "BLK Customer Reviews",
  "settings": [],
  "presets": [
    {
      "name": "BLK Customer Reviews"
    }
  ]
}
{% endschema %}