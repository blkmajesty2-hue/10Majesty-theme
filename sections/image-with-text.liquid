<section class="wrap mechanism">
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow center">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
  {%- if section.settings.heading != blank -%}<h2 class="center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="split">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 760px) 100vw, 50vw', widths: '600, 900, 1200' }}
    {%- else -%}
      <img src="{{ section.settings.fallback_image | default: 'blkm-details-beige.webp' | asset_url }}" alt="{{ section.settings.image_heading | escape }}" width="1254" height="1254" loading="lazy">
    {%- endif -%}
    <div>
      {%- if section.settings.image_eyebrow != blank -%}<p class="eyebrow">{{ section.settings.image_eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.image_heading | newline_to_br }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="primary" href="{{ section.settings.button_link | default: '#buy' }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="three-points">
      {%- for block in section.blocks -%}
        <article {{ block.shopify_attributes }}>
          <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_image", "label": "Built-in image file", "default": "blkm-details-beige.webp", "info": "Used when no image is picked. One of: blkm-duo.webp, blkm-details-black.webp, blkm-details-beige.webp, blkm-closer-look.webp, blkm-blue.webp" },
    { "type": "text", "id": "image_eyebrow", "label": "Text eyebrow" },
    { "type": "textarea", "id": "image_heading", "label": "Text heading", "default": "Designed around the details." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to jump to the product's buy box." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Point" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
