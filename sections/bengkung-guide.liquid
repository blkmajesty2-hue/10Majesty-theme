{%- comment -%}
  Story-style landing page (advertorial). Every heading, paragraph, image, quote and button is a block,
  so the page can be rewritten and reordered in Customize. Images fall back to built-in theme photos.
{%- endcomment -%}
{%- liquid
  assign link = section.settings.button_link | default: routes.all_products_collection_url
-%}
<section class="bg-guide">
  {%- if section.settings.kicker_left != blank or section.settings.kicker_right != blank -%}
    <div class="bg-kicker"><span>{{ section.settings.kicker_left | escape }}</span><span>{{ section.settings.kicker_right | escape }}</span></div>
  {%- endif -%}
  <article class="bg-article">
    {%- if section.settings.tag != blank -%}<p class="bg-tag">{{ section.settings.tag | escape }}</p>{%- endif -%}
    <h1 class="bg-title">{{ section.settings.title | escape }}</h1>
    {%- if section.settings.byline != blank -%}<p class="bg-byline">{{ section.settings.byline | escape }}</p>{%- endif -%}
    {%- if section.settings.hero_image != blank -%}
      {{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', class: 'bg-img', sizes: '(max-width: 720px) 100vw, 680px', widths: '500, 700, 1000, 1400', alt: section.settings.title }}
    {%- elsif section.settings.hero_image_url != blank -%}
      <img class="bg-img" src="{{ section.settings.hero_image_url | escape }}" alt="{{ section.settings.title | escape }}" width="900" height="1100" fetchpriority="high">
    {%- elsif section.settings.hero_fallback != blank -%}
      <img class="bg-img" src="{{ section.settings.hero_fallback | asset_url }}" alt="{{ section.settings.title | escape }}" width="1254" height="1254">
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="bg-h2" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
        {%- when 'text' -%}
          <div class="bg-text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'image' -%}
          <figure class="bg-figure{% if block.settings.narrow %} bg-figure--narrow{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'bg-img', sizes: '(max-width: 720px) 100vw, 680px', widths: '500, 700, 1000, 1400', alt: block.settings.caption }}
            {%- elsif block.settings.image_url != blank -%}
              <img class="bg-img" src="{{ block.settings.image_url | escape }}" alt="{{ block.settings.caption | escape }}" width="900" height="1100" loading="lazy">
            {%- else -%}
              <img class="bg-img" src="{{ block.settings.fallback_image | default: 'blkm-duo.webp' | asset_url }}" alt="{{ block.settings.caption | escape }}" width="1254" height="1254" loading="lazy">
            {%- endif -%}
            {%- if block.settings.caption != blank and block.settings.hide_caption != true -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
          </figure>
        {%- when 'quote' -%}
          <blockquote class="bg-quote" {{ block.shopify_attributes }}>
            “{{ block.settings.quote | escape }}”
            {%- if block.settings.cite != blank -%}<cite>{{ block.settings.cite | escape }}</cite>{%- endif -%}
          </blockquote>
        {%- when 'pull' -%}
          <p class="bg-pull" {{ block.shopify_attributes }}>{{ block.settings.text | escape | newline_to_br }}</p>
        {%- when 'callout' -%}
          <div class="bg-callout" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
            {{ block.settings.text }}
          </div>
        {%- when 'badges' -%}
          <div class="bg-badges" {{ block.shopify_attributes }}>
            {%- for i in (1..3) -%}
              {%- assign big_key = 'big_' | append: i -%}
              {%- assign small_key = 'small_' | append: i -%}
              {%- if block.settings[big_key] != blank -%}
                <div><b>{{ block.settings[big_key] | escape }}</b><small>{{ block.settings[small_key] | escape }}</small></div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- when 'review' -%}
          <blockquote class="bg-quote bg-review" {{ block.shopify_attributes }}>
            <span class="bg-stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</span>
            <strong>{{ block.settings.name | escape }}{% if block.settings.verified %} · Verified buyer{% endif %}</strong>
            “{{ block.settings.text | escape }}”
          </blockquote>
        {%- when 'button' -%}
          <div class="bg-cta-wrap" {{ block.shopify_attributes }}>
            <a class="bg-cta" href="{{ block.settings.link | default: link }}">{{ block.settings.label | escape }}</a>
            {%- if block.settings.note != blank -%}<p class="bg-note">{{ block.settings.note | escape }}</p>{%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </article>

  <div class="bg-foot">
    <strong>{{ section.settings.footer_brand | escape }}</strong>
    {%- if section.settings.footer_line != blank -%}<br>{{ section.settings.footer_line | escape }}{%- endif -%}
    {%- if section.settings.disclaimer != blank -%}<p>{{ section.settings.disclaimer | escape }}</p>{%- endif -%}
  </div>

  {%- if section.settings.sticky_label != blank -%}
    <div class="bg-sticky">
      <a href="{{ link }}">{{ section.settings.sticky_label | escape }}</a>
      {%- if section.settings.sticky_note != blank -%}<small>{{ section.settings.sticky_note | escape }}</small>{%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Story landing page",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Top of page" },
    { "type": "text", "id": "kicker_left", "label": "Top bar text (left)", "default": "SILHOUETTE SUPPORT · AFTER PREGNANCY" },
    { "type": "text", "id": "kicker_right", "label": "Top bar text (right)", "default": "BLK_MAJESTY JOURNAL" },
    { "type": "text", "id": "tag", "label": "Label", "default": "Guide" },
    { "type": "textarea", "id": "title", "label": "Headline", "default": "Years after pregnancy, your stomach still hasn't “bounced back”? Here's what nobody explained." },
    { "type": "text", "id": "byline", "label": "Byline", "default": "By the BLK_MAJESTY team" },
    { "type": "image_picker", "id": "hero_image", "label": "Main image" },
    { "type": "text", "id": "hero_image_url", "label": "Main image URL", "info": "Used when no main image is picked, e.g. a link from Content → Files." },
    { "type": "text", "id": "hero_fallback", "label": "Built-in main image file", "default": "blkm-duo.webp", "info": "Used when no main image is picked. Leave empty for none." },
    { "type": "url", "id": "button_link", "label": "Default button link", "info": "Used by the sticky bar and by any button block without its own link." },
    { "type": "header", "content": "Bottom of page" },
    { "type": "text", "id": "footer_brand", "label": "Footer brand", "default": "BLK_MAJESTY" },
    { "type": "text", "id": "footer_line", "label": "Footer line", "default": "Sizes S–3XL · Free shipping over $75 · 30-day money-back guarantee", "info": "Only add a rating here once you have real reviews to back it up." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "BLK_MAJESTY shapewear provides aesthetic silhouette support while it is worn. It is not a medical device or a treatment for diastasis recti. Individual experiences vary. For medical concerns, consult a qualified healthcare professional." },
    { "type": "text", "id": "sticky_label", "label": "Sticky button text", "default": "I WANT TO FEEL LIKE MYSELF AGAIN →", "info": "Leave empty to hide the sticky bar." },
    { "type": "text", "id": "sticky_note", "label": "Sticky bar note", "default": "Buy 2, get 2 free · 30-day money-back guarantee" }
  ],
  "blocks": [
    { "type": "heading", "name": "Heading", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "A new chapter" }
    ] },
    { "type": "text", "name": "Text", "settings": [
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Write your story here.</p>" }
    ] },
    { "type": "image", "name": "Image", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_url", "label": "Image URL", "info": "Used when no image is picked, e.g. a link from Content → Files." },
      { "type": "text", "id": "fallback_image", "label": "Built-in image file", "default": "blkm-duo.webp", "info": "Used when no image is picked. e.g. blkm-duo.webp, blkm-details-black.webp, blkm-details-beige.webp, blkm-closer-look.webp, blkm-blue.webp, blkm-color-navy.webp" },
      { "type": "text", "id": "caption", "label": "Caption / alt text" },
      { "type": "checkbox", "id": "hide_caption", "label": "Use caption as alt text only (hide it)", "default": false },
      { "type": "checkbox", "id": "narrow", "label": "Narrow (for phone screenshots)", "default": false }
    ] },
    { "type": "quote", "name": "Quote", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "A quote." },
      { "type": "text", "id": "cite", "label": "Who said it" }
    ] },
    { "type": "pull", "name": "Big statement", "settings": [
      { "type": "textarea", "id": "text", "label": "Text", "default": "It is not your fault." }
    ] },
    { "type": "callout", "name": "Info box", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Good to know" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add details here.</p>" }
    ] },
    { "type": "badges", "name": "Feature tiles", "settings": [
      { "type": "text", "id": "big_1", "label": "Tile 1 big text", "default": "✕" },
      { "type": "text", "id": "small_1", "label": "Tile 1 small text", "default": "Cross-over X design" },
      { "type": "text", "id": "big_2", "label": "Tile 2 big text", "default": "All day" },
      { "type": "text", "id": "small_2", "label": "Tile 2 small text", "default": "Smooth under clothes" },
      { "type": "text", "id": "big_3", "label": "Tile 3 big text", "default": "S→3XL" },
      { "type": "text", "id": "small_3", "label": "Tile 3 small text", "default": "7 colors" }
    ] },
    { "type": "review", "name": "Customer review", "settings": [
      { "type": "paragraph", "content": "Only add reviews from real customers." },
      { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
      { "type": "textarea", "id": "text", "label": "Review", "default": "What the customer said." },
      { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
    ] },
    { "type": "button", "name": "Button", "settings": [
      { "type": "text", "id": "label", "label": "Button text", "default": "SHOP NOW →" },
      { "type": "url", "id": "link", "label": "Link", "info": "Empty uses the default button link." },
      { "type": "text", "id": "note", "label": "Text under button", "default": "Buy 2, get 2 free · 30-day money-back guarantee · Free shipping over $75" }
    ] }
  ],
  "presets": [{ "name": "Story landing page" }]
}
{% endschema %}
