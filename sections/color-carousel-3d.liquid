{%- comment -%}
  Luxury color showcase: optional cinematic film/still, then an interactive stage where the selected
  color floats forward on a black pedestal and the other colors recede in a curved arc behind it.
{%- endcomment -%}
{%- liquid
  assign link_product = section.settings.product | default: product
  assign front = section.settings.start | minus: 1
  if front >= section.blocks.size or front < 0
    assign front = 0
  endif
-%}
<section class="c3d" data-c3d data-auto="{{ section.settings.auto_rotate }}" data-interval="{{ section.settings.interval }}" data-start="{{ front }}">
  <div class="c3d__head">
    {%- if section.settings.eyebrow != blank -%}<p class="c3d__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="c3d__title">{{ section.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="c3d__text">{{ section.settings.text | escape }}</p>{%- endif -%}
    <ul class="c3d__features">
      {%- for i in (1..4) -%}
        {%- assign key = 'feature_' | append: i -%}
        {%- if section.settings[key] != blank -%}<li>{{ section.settings[key] | escape }}</li>{%- endif -%}
      {%- endfor -%}
    </ul>
  </div>

  {%- if section.settings.video != blank or section.settings.film_image != blank -%}
    <div class="c3d__film">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1600x' }}
      {%- else -%}
        {{ section.settings.film_image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '(max-width: 1240px) 100vw, 1200px', widths: '700, 1000, 1400, 2000, 2400', alt: section.settings.heading }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="c3d__studio">
    <div class="c3d__stage" data-c3d-stage aria-roledescription="carousel" aria-label="{{ section.settings.shade_heading | default: 'Colors' | escape }}">
      <span class="c3d__dust" aria-hidden="true">{% for i in (1..10) %}<i></i>{% endfor %}</span>
      <div class="c3d__pedestal" aria-hidden="true"></div>
      {%- for block in section.blocks -%}
        <figure class="c3d__item{% if forloop.index0 == front %} is-front{% endif %}" data-c3d-card data-color="{{ block.settings.color | escape }}" {{ block.shopify_attributes }}>
          <div class="c3d__float">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', draggable: 'false', alt: block.settings.color, sizes: '(max-width: 760px) 60vw, 380px', widths: '400, 600, 800' }}
            {%- else -%}
              <img src="{{ block.settings.fallback | default: 'blkm-cut-black.webp' | asset_url }}" alt="{{ block.settings.color | escape }}" width="800" height="800" loading="lazy" draggable="false">
            {%- endif -%}
          </div>
        </figure>
      {%- endfor -%}
    </div>

    {%- if section.settings.shade_heading != blank -%}<p class="c3d__shade">{{ section.settings.shade_heading | escape }}</p>{%- endif -%}
    <div class="c3d__chips" role="tablist" aria-label="{{ section.settings.shade_heading | default: 'Colors' | escape }}">
      {%- for block in section.blocks -%}
        <button type="button" class="c3d__chip" data-c3d-chip="{{ forloop.index0 }}" role="tab" aria-selected="{% if forloop.index0 == front %}true{% else %}false{% endif %}" aria-label="{{ block.settings.color | escape }}" title="{{ block.settings.color | escape }}" style="--chip: {{ block.settings.swatch }};"></button>
      {%- endfor -%}
    </div>
    <p class="c3d__name" data-c3d-name aria-live="polite">{{ section.blocks[front].settings.color | escape }}</p>

    {%- if section.settings.button_label != blank -%}
      <a class="c3d__button" data-c3d-shop href="{% if link_product %}{{ link_product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"{% if request.page_type == 'product' %} data-on-product{% endif %}>{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "3D color showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Headline", "default": "ENGINEERED TO SHAPE.\nDESIGNED TO MOVE." },
    { "type": "text", "id": "text", "label": "Supporting text", "default": "Targeted X-shaped support meets breathable, all-day comfort." },
    { "type": "text", "id": "feature_1", "label": "Feature label 1", "default": "360° SUPPORT" },
    { "type": "text", "id": "feature_2", "label": "Feature label 2", "default": "HIGH-WAIST SCULPTING" },
    { "type": "text", "id": "feature_3", "label": "Feature label 3", "default": "BREATHABLE MESH" },
    { "type": "text", "id": "feature_4", "label": "Feature label 4", "default": "S–3XL" },
    { "type": "header", "content": "Cinematic film" },
    { "type": "video", "id": "video", "label": "Video", "info": "Plays silently on loop above the color stage. Upload in Content → Files first." },
    { "type": "image_picker", "id": "film_image", "label": "Image (used when there is no video)" },
    { "type": "header", "content": "Color stage" },
    { "type": "text", "id": "shade_heading", "label": "Color heading", "default": "FIND YOUR SHADE" },
    { "type": "range", "id": "start", "label": "Color shown first", "min": 1, "max": 10, "step": 1, "default": 1 },
    { "type": "checkbox", "id": "auto_rotate", "label": "Change color automatically", "default": true },
    { "type": "range", "id": "interval", "label": "Seconds per color", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP THE COLLECTION" },
    { "type": "product", "id": "product", "label": "Product the button opens", "info": "On a product page the button selects the shown color in the bundle picker instead." }
  ],
  "blocks": [
    {
      "type": "color",
      "name": "Color",
      "limit": 10,
      "settings": [
        { "type": "text", "id": "color", "label": "Color name", "default": "Black", "info": "Match the product's Color option exactly (e.g. Navy Blue)." },
        { "type": "color", "id": "swatch", "label": "Swatch color", "default": "#000000" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Best as a transparent PNG/WebP cut-out, like the built-in photos." },
        { "type": "text", "id": "fallback", "label": "Built-in image file", "default": "blkm-cut-black.webp", "info": "Used when no image is picked." }
      ]
    }
  ],
  "presets": [
    {
      "name": "3D color showcase",
      "blocks": [
        { "type": "color", "settings": { "color": "Black", "swatch": "#111111", "fallback": "blkm-cut-black.webp" } },
        { "type": "color", "settings": { "color": "Beige", "swatch": "#e3cfa9", "fallback": "blkm-cut-beige.webp" } },
        { "type": "color", "settings": { "color": "Navy Blue", "swatch": "#1c2a55", "fallback": "blkm-cut-navy.webp" } },
        { "type": "color", "settings": { "color": "Lilac", "swatch": "#cbb2ef", "fallback": "blkm-cut-lilac.webp" } },
        { "type": "color", "settings": { "color": "Royal Blue", "swatch": "#1f4fd6", "fallback": "blkm-cut-royal-blue.webp" } },
        { "type": "color", "settings": { "color": "Fuchsia Pink", "swatch": "#e5187c", "fallback": "blkm-cut-fuchsia.webp" } },
        { "type": "color", "settings": { "color": "Plum", "swatch": "#5a1840", "fallback": "blkm-cut-plum.webp" } }
      ]
    }
  ]
}
{% endschema %}
