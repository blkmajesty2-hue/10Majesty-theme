  .cdv-modal{width:min(600px,calc(100vw - 32px));max-height:calc(100vh - 48px);padding:clamp(22px,4vw,36px);background:#fff;color:var(--cdv-ink);border:0;border-radius:var(--cdv-radius);box-shadow:0 20px 60px rgba(30,24,60,.25)}
