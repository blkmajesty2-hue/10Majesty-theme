<script>
  (function () {
    var root = document.getElementById('CoverlessDuvet-{{ section.id }}');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    var $ = function (sel, ctx) { return (ctx || root).querySelector(sel); };
    var $$ = function (sel, ctx) { return Array.prototype.slice.call((ctx || root).querySelectorAll(sel)); };
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var isDemo = root.dataset.demo === 'true';
    var handleize = function (s) { return String(s).toLowerCase().replace(/['"]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''); };

    function formatMoney(cents, format) {
      if (typeof cents === 'string') cents = cents.replace('.', '');
      format = format || root.dataset.moneyFormat || '$' + '{' + '{amount}}';
      var match = format.match(/\{\{\s*(\w+)\s*\}\}/);
      var fmt = function (n, decimals, thousands, decimal) {
        n = (Number(n) / 100).toFixed(decimals);
        var parts = n.split('.');
        parts[0] = parts[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1' + thousands);
        return parts[1] ? parts[0] + decimal + parts[1] : parts[0];
      };
      var value;
      switch (match ? match[1] : 'amount') {
        case 'amount_no_decimals': value = fmt(cents, 0, ',', '.'); break;
        case 'amount_with_comma_separator': value = fmt(cents, 2, '.', ','); break;
        case 'amount_no_decimals_with_comma_separator': value = fmt(cents, 0, '.', ','); break;
        case 'amount_with_apostrophe_separator': value = fmt(cents, 2, "'", '.'); break;
        default: value = fmt(cents, 2, ',', '.');
      }
      return format.replace(/\{\{\s*\w+\s*\}\}/, value);
    }

    /* ── Header & menu ── */
    var header = $('[data-header]');
    function setHeaderHeight() { if (header) root.style.setProperty('--cdv-header-h', header.offsetHeight + 'px'); }
    setHeaderHeight();
    if (header) {
      var onScroll = function () { header.classList.toggle('is-scrolled', window.scrollY > 8); };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
    var menu = $('[data-menu]');
    var menuOpen = $('[data-menu-open]');
    if (menu && menuOpen && menu.showModal) {
      menuOpen.addEventListener('click', function () { menu.showModal(); menuOpen.setAttribute('aria-expanded', 'true'); });
      $$('[data-menu-close], [data-menu-link]', menu).forEach(function (el) { el.addEventListener('click', function () { menu.close(); }); });
      menu.addEventListener('close', function () { menuOpen.setAttribute('aria-expanded', 'false'); });
      menu.addEventListener('click', function (e) { if (e.target === menu) menu.close(); });
    }

    /* ── Size guide ── */
    var sizeGuide = $('[data-size-guide]');
    if (sizeGuide && sizeGuide.showModal) {
      root.addEventListener('click', function (e) {
        if (e.target.closest('[data-size-guide-open]')) sizeGuide.showModal();
      });
      $('[data-size-guide-close]', sizeGuide).addEventListener('click', function () { sizeGuide.close(); });
      sizeGuide.addEventListener('click', function (e) { if (e.target === sizeGuide) sizeGuide.close(); });
    }

    /* ── Videos (lazy, never autoplay with sound) ── */
    $$('[data-video]').forEach(function (wrap) {
      var play = $('[data-video-play]', wrap);
      var tpl = $('[data-video-template]', wrap);
      if (!play || !tpl) return;
      play.addEventListener('click', function () {
        var node = tpl.content.firstElementChild.cloneNode(true);
        wrap.appendChild(node);
        play.remove();
        if (node.tagName === 'VIDEO') { node.play().catch(function () {}); node.focus(); }
      });
    });

    /* ── Review sorting ── */
    var sort = $('[data-review-sort]');
    var reviewTrack = $('[data-review-track]');
    if (sort && reviewTrack) {
      var sortReviews = function () {
        var items = $$('[data-review]', reviewTrack);
        items.sort(function (a, b) {
          if (sort.value === 'highest') return b.dataset.rating - a.dataset.rating;
          if (sort.value === 'lowest') return a.dataset.rating - b.dataset.rating;
          return (Date.parse(b.dataset.date) || 0) - (Date.parse(a.dataset.date) || 0);
        });
        items.forEach(function (el) { reviewTrack.appendChild(el); });
      };
      sort.addEventListener('change', sortReviews);
      sortReviews();
    }

    /* ── Product ── */
    var variantsEl = $('[data-variants-json]');
    if (!variantsEl) return;
    var variants = JSON.parse(variantsEl.textContent);
    var swatches = {};
    try { swatches = JSON.parse($('[data-swatches-json]').textContent); } catch (e) {}
    var swatchFor = function (value) { return swatches[handleize(value)] || '#e8e2d8'; };
    $$('[data-color-dot]').forEach(function (dot) { dot.style.setProperty('--swatch', swatches[dot.dataset.colorDot] || '#e8e2d8'); });

    var form = $('[data-product-form]');
    var idInput = $('[data-variant-id]');
    var addButton = $('[data-add-button]');
    var addLabel = $('[data-add-label]');
    var addPrice = $('[data-add-price]');
    var qtyInput = $('[data-qty]');
    var message = $('[data-form-message]');
    var colorIndex = {{ color_index }};
    var rowsWrap = $('[data-rows]');
    var rows = rowsWrap ? $$('[data-row]', rowsWrap) : [];
    var bundleWrap = $('[data-bundles]');

    var current = variants.find(function (v) { return String(v.id) === idInput.value; }) || variants[0];

    function findVariant(options) {
      return variants.find(function (v) { return v.options.every(function (o, i) { return o === options[i]; }); });
    }
    function rowOptions(row) { return $$('[data-row-select]', row).map(function (s) { return s.value; }); }
    function rowVariant(row) { return row ? findVariant(rowOptions(row)) : current; }

    var narrow = window.matchMedia('(max-width: 749px)');
    function refreshRow(row) {
      var opts = rowOptions(row);
      var dot = $('[data-dot]', row);
      if (dot && colorIndex >= 0) dot.style.setProperty('--swatch', swatchFor(opts[colorIndex]));
      $$('[data-row-select]', row).forEach(function (sel) {
        var idx = Number(sel.dataset.rowSelect);
        Array.prototype.forEach.call(sel.options, function (opt) {
          var test = opts.slice();
          test[idx] = opt.value;
          var v = findVariant(test);
          var label = narrow.matches ? opt.value.split(' (')[0] : opt.value;
          opt.textContent = label + (v && v.available ? '' : ' — sold out');
        });
      });
      var v = findVariant(opts);
      var status = $('[data-row-status]', row);
      if (status) status.textContent = !v ? 'This combination is unavailable.' : (v.available ? '' : 'This option is sold out.');
    }

    /* Gallery */
    var track = $('[data-gallery-track]');
    var thumbsTrack = $('[data-thumbs]');
    var dots = $('[data-gallery-dots]');
    var count = $('[data-gallery-count]');
    function visibleSlides() { return track ? $$('[data-slide]', track).filter(function (s) { return !s.hidden; }) : []; }
    function currentIndex() { return track ? Math.round(track.scrollLeft / (track.clientWidth || 1)) : 0; }
    function goTo(i, smooth) {
      var slides = visibleSlides();
      if (!slides.length) return;
      i = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: i * track.clientWidth, behavior: smooth && !reduceMotion ? 'smooth' : 'auto' });
    }
    function syncGalleryUI() {
      if (!track) return;
      var i = currentIndex();
      var slides = visibleSlides();
      var active = slides[i];
      if (thumbsTrack) {
        $$('[data-thumb]', thumbsTrack).forEach(function (t) {
          var on = !!active && t.dataset.mediaId === active.dataset.mediaId;
          t.classList.toggle('is-active', on);
          if (on) {
            var left = t.offsetLeft - thumbsTrack.offsetLeft;
            if (left < thumbsTrack.scrollLeft || left + t.offsetWidth > thumbsTrack.scrollLeft + thumbsTrack.clientWidth) thumbsTrack.scrollLeft = Math.max(0, left - 40);
          }
        });
      }
      if (dots) $$('span', dots).forEach(function (d, j) { d.classList.toggle('is-active', i === j); });
      if (count && slides.length > 1) count.textContent = 'Image ' + (i + 1) + ' of ' + slides.length;
    }
    function selectedColorHandle() {
      if (colorIndex < 0) return '';
      var opts = rows[0] ? rowOptions(rows[0]) : current.options;
      return handleize(opts[colorIndex]);
    }
    function layoutGallery(leadMediaId) {
      if (!track) return;
      var colorHandle = selectedColorHandle();
      var lead = null;
      $$('[data-slide]', track).forEach(function (s) {
        s.hidden = !!(s.dataset.color && s.dataset.color !== colorHandle);
        s.classList.remove('is-lead');
        if (leadMediaId && s.dataset.mediaId === String(leadMediaId)) lead = s;
      });
      if (thumbsTrack) $$('[data-thumb]', thumbsTrack).forEach(function (t) { t.hidden = !!(t.dataset.color && t.dataset.color !== colorHandle); });
      if (!lead || lead.hidden) lead = visibleSlides().find(function (s) { return colorHandle && s.dataset.color === colorHandle; }) || visibleSlides()[0];
      if (lead) {
        lead.classList.add('is-lead');
        track.insertBefore(lead, track.firstChild);
        var thumb = thumbsTrack && $('[data-thumb][data-media-id="' + lead.dataset.mediaId + '"]', thumbsTrack);
        if (thumb) thumbsTrack.insertBefore(thumb, thumbsTrack.firstChild);
      }
      if (dots) {
        var n = visibleSlides().length;
        dots.innerHTML = n > 1 ? new Array(n + 1).join('<span></span>') : '';
      }
      track.scrollLeft = 0;
      if (thumbsTrack) thumbsTrack.scrollLeft = 0;
      syncGalleryUI();
    }
    if (track) {
      var raf;
      track.addEventListener('scroll', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(syncGalleryUI); }, { passive: true });
      if (thumbsTrack) {
        thumbsTrack.addEventListener('click', function (e) {
          var t = e.target.closest('[data-thumb]');
          if (!t) return;
          var idx = visibleSlides().findIndex(function (s) { return s.dataset.mediaId === t.dataset.mediaId; });
          goTo(idx, true);
        });
      }
      var prev = $('[data-gallery-prev]');
      var next = $('[data-gallery-next]');
      if (prev) prev.addEventListener('click', function () { goTo(currentIndex() - 1, true); });
      if (next) next.addEventListener('click', function () { goTo(currentIndex() + 1, true); });
      track.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); goTo(currentIndex() + 1, true); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(currentIndex() - 1, true); }
      });
    }

    /* Bundles */
    function checkedBundle() { return bundleWrap ? $('[data-bundle-option]:checked', bundleWrap) : null; }
    function bundleQty() { var c = checkedBundle(); return c ? Number(c.value) : 1; }
    function bundlePct() { var c = checkedBundle(); return c ? Number(c.dataset.savings) || 0 : 0; }
    function itemsFor(q) {
      var items = [];
      for (var n = 0; n < q; n++) items.push(rowVariant(rows[n] || rows[0]));
      return items;
    }
    function updateBundles() {
      if (!bundleWrap) return;
      var q = bundleQty();
      rows.forEach(function (row, i) { row.hidden = i >= q; });
      $$('[data-bundle]', bundleWrap).forEach(function (card) {
        var input = $('[data-bundle-option]', card);
        var panel = $('[data-bundle-panel]', card);
        card.classList.toggle('is-selected', input.checked);
        if (input.checked && rowsWrap && rowsWrap.parentElement !== panel) panel.appendChild(rowsWrap);
        var cq = Number(input.value);
        var items = itemsFor(cq);
        var valid = items.every(function (v) { return v; });
        var pct = Number(input.dataset.savings) || 0;
        var total = valid ? items.reduce(function (s, v) { return s + v.price; }, 0) : 0;
        var finalTotal = total - Math.round(total * pct / 100);
        var compareTotal = valid ? items.reduce(function (s, v) { return s + Math.max(v.compare_at_price || 0, v.price); }, 0) : 0;
        var saved = compareTotal - finalTotal;
        $('[data-bundle-total]', card).textContent = valid ? formatMoney(finalTotal) : '—';
        var cmp = $('[data-bundle-compare]', card);
        cmp.hidden = !(valid && compareTotal > finalTotal);
        if (!cmp.hidden) cmp.textContent = formatMoney(compareTotal);
        var each = $('[data-bundle-each]', card);
        each.hidden = !(valid && cq > 1);
        if (!each.hidden) each.textContent = formatMoney(Math.round(finalTotal / cq)) + ' / duvet';
        var save = $('[data-bundle-save]', card);
        save.hidden = !(valid && saved > 0);
        if (!save.hidden) save.textContent = 'You save ' + formatMoney(saved);
      });
    }

    function updatePrices() {
      if (!current) return;
      var q = bundleQty();
      var total, ok;
      if (bundleWrap) {
        var items = itemsFor(q);
        ok = items.every(function (v) { return v && v.available; });
        total = ok ? items.reduce(function (s, v) { return s + v.price; }, 0) : 0;
        total -= Math.round(total * bundlePct() / 100);
        addLabel.textContent = !ok ? (q > 1 ? 'Check your selections' : 'Sold out') : (q > 1 ? 'Add ' + q + ' to Bag' : 'Add to Bag');
      } else {
        ok = !!current.available;
        total = current.price * ((qtyInput && parseInt(qtyInput.value, 10)) || 1);
        addLabel.textContent = ok ? 'Add to Bag' : 'Sold out';
      }
      addButton.disabled = !ok;
      addPrice.textContent = ok ? formatMoney(total) : '';
      var stickyPrice = $('[data-sticky-price]');
      if (stickyPrice) stickyPrice.textContent = formatMoney(total || current.price);
      var stickyBtn = $('[data-sticky-add]');
      if (stickyBtn) { stickyBtn.disabled = !ok; stickyBtn.textContent = ok ? (q > 1 ? 'Add ' + q + ' to Bag' : 'Add to Bag') : 'Unavailable'; }
    }

    function renderMain(galleryChanged) {
      var v = rowVariant(rows[0]);
      var stickyVariant = $('[data-sticky-variant]');
      if (!v) {
        addButton.disabled = true;
        addLabel.textContent = 'Unavailable';
        addPrice.textContent = '';
        if (stickyVariant) stickyVariant.textContent = 'Unavailable';
        updateBundles();
        return;
      }
      current = v;
      idInput.value = v.id;
      $('[data-price]').textContent = formatMoney(v.price);
      var onSale = v.compare_at_price && v.compare_at_price > v.price;
      $('[data-compare-price]').hidden = !onSale;
      $('[data-save-badge]').hidden = !onSale;
      if (onSale) {
        $('[data-compare-price]').textContent = formatMoney(v.compare_at_price);
        var amt = $('[data-save-amount]');
        if (amt) amt.textContent = formatMoney(v.compare_at_price - v.price);
      }
      if (stickyVariant) stickyVariant.textContent = v.title;
      if (galleryChanged && track) {
        track.style.opacity = '.35';
        setTimeout(function () { layoutGallery(v.featured_media && v.featured_media.id); track.style.opacity = ''; }, reduceMotion ? 0 : 140);
      }
      if (!isDemo && window.history.replaceState) {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', v.id);
        window.history.replaceState({}, '', url.toString());
      }
      updateBundles();
      updatePrices();
    }

    rows.forEach(function (row, r) {
      $$('[data-row-select]', row).forEach(function (sel) {
        sel.addEventListener('change', function () {
          var idx = Number(sel.dataset.rowSelect);
          if (r === 0) {
            /* other duvets follow the first until the shopper changes them */
            rows.slice(1).forEach(function (other) {
              if (other.dataset.touched) return;
              var s = $('[data-row-select="' + idx + '"]', other);
              if (s) { s.value = sel.value; refreshRow(other); }
            });
          } else {
            row.dataset.touched = 'true';
          }
          refreshRow(row);
          if (r === 0) renderMain(idx === colorIndex);
          else { updateBundles(); updatePrices(); }
        });
      });
      refreshRow(row);
    });
    if (narrow.addEventListener) narrow.addEventListener('change', function () { rows.forEach(refreshRow); });
    if (bundleWrap) {
      $$('[data-bundle-option]', bundleWrap).forEach(function (input) {
        input.addEventListener('change', function () { updateBundles(); updatePrices(); });
      });
    }
    if (qtyInput) {
      $$('[data-qty-step]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          qtyInput.value = Math.max(1, Math.min(20, (parseInt(qtyInput.value, 10) || 1) + Number(btn.dataset.qtyStep)));
          updatePrices();
        });
      });
      qtyInput.addEventListener('change', function () {
        qtyInput.value = Math.max(1, Math.min(20, parseInt(qtyInput.value, 10) || 1));
        updatePrices();
      });
    }

    /* Add to bag */
    function cartItems() {
      if (!bundleWrap) return current ? [{ id: current.id, quantity: (qtyInput && parseInt(qtyInput.value, 10)) || 1 }] : [];
      var items = itemsFor(bundleQty());
      if (!items.every(function (v) { return v && v.available; })) return null;
      var merged = {};
      items.forEach(function (v) { merged[v.id] = (merged[v.id] || 0) + 1; });
      return Object.keys(merged).map(function (id) { return { id: Number(id), quantity: merged[id] }; });
    }
    function showMessage(html, type) {
      message.hidden = false;
      message.className = 'cdv-form__message' + (type ? ' is-' + type : '');
      message.innerHTML = html;
    }
    function updateBagCount(n) {
      var el = $('[data-bag-count]');
      var link = $('[data-bag-link]');
      if (el) { el.textContent = n; el.hidden = n === 0; }
      if (link) link.setAttribute('aria-label', 'Shopping bag, ' + n + ' items');
    }
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var items = cartItems();
        if (!items || !items.length) { showMessage('Please check your selections — one of the options is unavailable.', 'error'); return; }
        if (isDemo) {
          showMessage('<strong>Demo preview:</strong> checkout is not connected here, so nothing was added. On your Shopify store this button adds the selected duvet(s) to the real cart.', 'demo');
          return;
        }
        addButton.disabled = true;
        addButton.setAttribute('aria-busy', 'true');
        fetch(root.dataset.cartAddUrl + '.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: items })
        })
          .then(function (res) { return res.json().then(function (data) { if (!res.ok) throw data; return data; }); })
          .then(function () { return fetch(root.dataset.cartUrl + '.js').then(function (r) { return r.json(); }); })
          .then(function (cart) {
            updateBagCount(cart.item_count);
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
            showMessage('Added to your bag. <a href="' + root.dataset.cartUrl + '">View bag &amp; check out</a>');
          })
          .catch(function (err) {
            showMessage((err && (err.description || err.message)) || 'Sorry, we couldn’t add that to your bag. Please try again.', 'error');
          })
          .finally(function () {
            addButton.removeAttribute('aria-busy');
            updatePrices();
          });
      });
    }

    /* Mobile purchase bar */
    var bar = $('[data-sticky-bar]');
    if (bar && addButton && 'IntersectionObserver' in window) {
      var stickyBtn = $('[data-sticky-add]', bar);
      var footer = $('.cdv-footer');
      var addVisible = true;
      var footerVisible = false;
      var toggleBar = function () {
        var show = !addVisible && !footerVisible && addButton.getBoundingClientRect().top < 0;
        bar.classList.toggle('is-visible', show);
        bar.setAttribute('aria-hidden', show ? 'false' : 'true');
        stickyBtn.tabIndex = show ? 0 : -1;
      };
      new IntersectionObserver(function (entries) { addVisible = entries[0].isIntersecting; toggleBar(); }).observe(addButton);
      if (footer) new IntersectionObserver(function (entries) { footerVisible = entries[0].isIntersecting; toggleBar(); }).observe(footer);
      stickyBtn.addEventListener('click', function () {
        if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event('submit', { cancelable: true }));
        setTimeout(function () { message.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' }); }, 60);
      });
    }

    window.addEventListener('resize', function () { setHeaderHeight(); syncGalleryUI(); });
    layoutGallery(current.featured_media && current.featured_media.id);
    renderMain(false);
  })();
</script>

