<section class="circles" style="--circle-border: {{ section.settings.border_color }};">
  {%- if section.settings.heading != blank -%}<h2 class="{% if section.settings.serif %}serif-heading{% endif %}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="circles__grid">
    {%- for block in section.blocks -%}
      <figure class="circles__item" {{ block.shopify_attributes }}>
        <div class="circles__img">
          {%- if block.settings.image != blank -%}
            {%- capture img_style -%}transform-origin:{{ block.settings.focus_x }}% {{ block.settings.focus_y }}%;transform:scale({{ block.settings.zoom | divided_by: 100.0 }}){%- endcapture -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.caption, style: img_style }}
          {%- else -%}
            <img src="{{ block.settings.fallback | default: 'blkm-closer-look.webp' | asset_url }}" alt="{{ block.settings.caption | escape }}" width="600" height="600" loading="lazy" style="transform-origin:{{ block.settings.focus_x }}% {{ block.settings.focus_y }}%;transform:scale({{ block.settings.zoom | divided_by: 100.0 }})">
          {%- endif -%}
        </div>
        <figcaption>{{ block.settings.caption | escape }}</figcaption>
      </figure>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Circle features",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why it's NOT ordinary shapewear" },
    { "type": "checkbox", "id": "serif", "label": "Serif heading", "default": true },
    { "type": "color", "id": "border_color", "label": "Circle border color", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "circle",
      "name": "Circle",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Built-in image file", "default": "blkm-closer-look.webp", "info": "Used when no image is picked." },
        { "type": "range", "id": "zoom", "label": "Zoom", "min": 100, "max": 300, "step": 10, "unit": "%", "default": 100 },
        { "type": "range", "id": "focus_x", "label": "Focus left ↔ right", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
        { "type": "range", "id": "focus_y", "label": "Focus top ↕ bottom", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Feature" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Circle features",
      "blocks": [
        { "type": "circle", "settings": { "fallback": "blkm-color-royal-blue.webp", "zoom": 220, "focus_x": 55, "focus_y": 38, "caption": "Crossover high-waist design" } },
        { "type": "circle", "settings": { "fallback": "blkm-color-navy.webp", "zoom": 190, "focus_x": 50, "focus_y": 72, "caption": "Sculpting cut, shaping effect" } }
      ]
    }
  ]
}
{% endschema %}
