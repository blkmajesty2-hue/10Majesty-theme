<section class="hero-banner hero-banner--{{ section.settings.text_side }}" style="--hb-overlay: {{ section.settings.overlay }}%; --hb-text: {{ section.settings.text_color }};">
  <div class="hero-banner__media">
    {%- if section.settings.image != blank -%}
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source media="(max-width: 760px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }} 900w, {{ section.settings.image_mobile | image_url: width: 1400 }} 1400w" sizes="100vw">
          {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2000, 2400', alt: section.settings.heading }}
        </picture>
      {%- else -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2000, 2400', alt: section.settings.heading }}
      {%- endif -%}
    {%- else -%}
      <img src="{{ section.settings.fallback_image | default: 'blkm-hero-banner.webp' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1920" height="1080" fetchpriority="high">
    {%- endif -%}
  </div>
  <div class="hero-banner__content">
    {%- if section.settings.eyebrow != blank -%}<p class="hero-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="hero-banner__title{% if section.settings.serif %} serif-heading{% endif %}">{{ section.settings.heading | newline_to_br }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="hero-banner__text">{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="hero-banner__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.small_text != blank -%}<p class="hero-banner__small">{{ section.settings.small_text | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero banner (full width)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image (desktop)", "info": "Wide 16:9 image, at least 2400 × 1350 px. Keep the left side calm for the text." },
    { "type": "image_picker", "id": "image_mobile", "label": "Banner image (phone, optional)", "info": "Tall or square image for phones. Without it, the desktop image is cropped." },
    { "type": "text", "id": "fallback_image", "label": "Built-in image file", "default": "blkm-hero-banner.webp" },
    { "type": "select", "id": "text_side", "label": "Text position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }, { "value": "center", "label": "Center" }] },
    { "type": "range", "id": "overlay", "label": "Text background fade", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0a0a0a" },
    { "type": "text", "id": "eyebrow", "label": "Small line above heading" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "POSTPARTUM SUPPORT,\nREIMAGINED." },
    { "type": "checkbox", "id": "serif", "label": "Serif heading", "default": true },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sculpting comfort designed to support you through every movement." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP NOW" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "small_text", "label": "Small text under button", "default": "BLK_MAJESTY" }
  ],
  "presets": [{ "name": "Hero banner (full width)" }]
}
{% endschema %}
