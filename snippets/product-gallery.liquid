{%- comment -%}
  Product gallery with thumbnails and zoom dialog. Accepts: product, zoom_id.
  Falls back to the theme's built-in photos when the product has no media yet.
{%- endcomment -%}
{%- liquid
  assign featured = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign fallback = 'blkm-duo.webp,blkm-details-black.webp,blkm-details-beige.webp,blkm-closer-look.webp,blkm-blue.webp' | split: ','
-%}
<div class="gallery" data-gallery data-zoom="{{ zoom_id }}">
  <button type="button" class="main-picture" data-dialog="{{ zoom_id }}" aria-label="Enlarge selected product image">
    {%- if featured -%}
      {{ featured.preview_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(max-width: 900px) 100vw, 50vw', widths: '600, 900, 1200, 1400', alt: featured.alt | default: product.title }}
    {%- else -%}
      <img src="{{ fallback.first | asset_url }}" alt="{{ product.title | escape }}" width="1254" height="1254" fetchpriority="high">
    {%- endif -%}
  </button>
  <div class="thumbs" aria-label="Product images">
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        <button type="button" data-media-id="{{ media.id }}" data-image="{{ media.preview_image | image_url: width: 1400 }}" data-srcset="{{ media.preview_image | image_url: width: 700 }} 700w, {{ media.preview_image | image_url: width: 1400 }} 1400w" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="View product image {{ forloop.index }}" aria-pressed="{% if media.id == featured.id %}true{% else %}false{% endif %}">
          {{ media.preview_image | image_url: width: 150 | image_tag: loading: 'lazy', alt: '' }}
        </button>
      {%- endfor -%}
    {%- else -%}
      {%- for file in fallback -%}
        <button type="button" data-image="{{ file | asset_url }}" aria-label="View product image {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
          <img src="{{ file | asset_url }}" alt="" width="150" height="150" loading="lazy">
        </button>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>
<dialog id="{{ zoom_id }}" class="large-dialog">
  <button class="close" aria-label="{{ 'general.close' | t }}">×</button>
  {%- if featured -%}
    {{ featured.preview_image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: featured.alt | default: product.title }}
  {%- else -%}
    <img src="{{ fallback.first | asset_url }}" alt="{{ product.title | escape }}" width="1254" height="1254" loading="lazy">
  {%- endif -%}
</dialog>
