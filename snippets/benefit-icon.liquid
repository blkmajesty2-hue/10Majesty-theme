{%- comment -%} Line icons for product benefits. Usage: render 'benefit-icon', icon: 'shield' {%- endcomment -%}
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
  {%- case icon -%}
    {%- when 'person' -%}<circle cx="12" cy="4" r="2"/><path d="M5 8h14M12 8v6M9 21l1.5-7h3L15 21"/>
    {%- when 'eye-off' -%}<path d="M3 3l18 18M10.6 6.1A9.8 9.8 0 0 1 12 6c5 0 9 6 9 6a16 16 0 0 1-3.2 3.6M6.6 7.6C4.2 9.2 3 12 3 12s4 6 9 6c1.6 0 3-.4 4.3-1"/><path d="M9.9 10a3 3 0 0 0 4.1 4.1"/>
    {%- when 'rotate' -%}<path d="M20 12a8 8 0 1 1-2.3-5.7"/><path d="M20 4v4h-4"/><circle cx="12" cy="12" r="2"/>
    {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'shield' -%}<path d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6z"/>
    {%- when 'layers' -%}<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>
    {%- when 'lock' -%}<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/><circle cx="12" cy="16" r="1"/>
    {%- when 'box' -%}<rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v11h14V9M10 13h4"/>
    {%- when 'truck' -%}<path d="M2 6h11v10H2zM13 10h4l3 3v3h-7z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
    {%- else -%}<path d="M5 12.5 10 17.5 19 7"/>
  {%- endcase -%}
</svg>
