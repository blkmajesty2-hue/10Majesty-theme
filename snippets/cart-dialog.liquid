{%- comment -%} Cart drawer, filled from the live cart. Also passes money format and strings to blkm.js. {%- endcomment -%}
{%- liquid
  assign free_ship = settings.free_shipping_threshold
  if cart.currency.iso_code == 'EUR' and settings.free_shipping_threshold_eur > 0
    assign free_ship = settings.free_shipping_threshold_eur
  elsif cart.currency.iso_code == 'SEK' and settings.free_shipping_threshold_sek > 0
    assign free_ship = settings.free_shipping_threshold_sek
  endif
  assign free_ship_cents = free_ship | times: 100 | round
-%}
<script>
  window.blkm = {
    moneyFormat: {% if cart.currency.iso_code == shop.currency %}{{ shop.money_format | json }}{% elsif cart.currency.iso_code == 'SEK' %}"{% raw %}{{amount_with_comma_separator}}{% endraw %} kr"{% else %}null{% endif %},
    currencySymbol: {{ cart.currency.symbol | json }},
    currency: {{ cart.currency.iso_code | json }},
    freeShipping: {{ free_ship_cents | default: 0 }},
    protectionMode: {{ settings.protection_mode | json }},
    protectionVariant: {% if settings.protection_mode != 'off' and settings.protection_product != blank %}{{ settings.protection_product.selected_or_first_available_variant.id }}{% else %}null{% endif %},
    strings: {
      addToCart: {{ 'products.add_to_cart' | t | json }},
      soldOut: {{ 'products.sold_out' | t | json }},
      unavailable: {{ 'products.unavailable' | t | json }},
      adding: {{ 'products.adding' | t | json }},
      added: {{ 'products.added' | t | json }},
      error: {{ 'products.error' | t | json }},
      comboUnavailable: {{ 'products.combination_unavailable' | t | json }},
      empty: {{ 'cart.empty' | t | json }},
      remove: {{ 'cart.remove' | t | json }},
      subtotal: {{ 'cart.subtotal' | t | json }},
      discounts: {{ 'cart.discounts' | t | json }},
      quantity: {{ 'cart.quantity' | t | json }},
      item: {{ 'cart.item' | t | json }},
      items: {{ 'cart.items' | t | json }},
      freeShipRemaining: {{ 'cart.free_shipping_remaining' | t | json }},
      freeShipReached: {{ 'cart.free_shipping_reached' | t | json }},
      decrease: {{ 'general.decrease' | t | json }},
      increase: {{ 'general.increase' | t | json }},
      bundle: {{ 'cart.bundle' | t | json }},
      itemOf: {{ 'cart.item_of' | t | json }},
      soundOn: {{ 'video.sound_on' | t | json }},
      soundOff: {{ 'video.sound_off' | t | json }},
      quizErrorIn: {{ 'quiz.error_in' | t | json }},
      quizErrorCm: {{ 'quiz.error_cm' | t | json }},
      quizSplit: {{ 'quiz.note_split' | t | json }},
      quizJeans: {{ 'quiz.note_jeans' | t | json }},
      quizBetween: {{ 'quiz.note_between' | t | json }},
      quizOver: {{ 'quiz.note_over' | t | json }},
      quizShopSize: {{ 'quiz.shop_size' | t | json }},
      quizExample: {{ 'quiz.example' | t | json }},
      copied: {{ 'quiz.copied' | t | json }}
    }
  };
</script>
<dialog id="bag" class="cart-drawer" aria-labelledby="bag-title">
  <div class="cart-drawer__head">
    <h2 id="bag-title">{{ 'cart.title' | t }}<span class="cart-drawer__count" data-cart-count-label></span></h2>
    <span class="cart-drawer__bubble" data-cart-count-bubble aria-hidden="true"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
    <button class="close" aria-label="{{ 'general.close' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"/></svg></button>
  </div>
  {%- if free_ship_cents > 0 -%}
    <div class="cart-drawer__ship" data-free-ship hidden>
      <p></p>
      <div class="cart-drawer__track">
        <div class="cart-drawer__bar"><span></span></div>
        <span class="cart-drawer__truck" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M2 6h11v10H2zM13 10h4l3 3v3h-7z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg></span>
      </div>
      <small class="cart-drawer__truck-label">{{ 'cart.free_shipping_label' | t }}</small>
    </div>
  {%- endif -%}
  <div class="cart-drawer__cols" data-cart-cols hidden><span>{{ 'cart.product' | t }}</span><span>{{ 'cart.total' | t }}</span></div>
  <div class="cart-drawer__scroll">
    <div id="bag-items" class="cart-drawer__items">
      {%- if cart.item_count == 0 -%}<p class="empty-bag">{{ 'cart.empty' | t }}</p>{%- endif -%}
    </div>
    {%- if settings.cart_upsell_products != blank -%}
      <div class="cart-upsell" data-upsell{% if cart.item_count == 0 %} hidden{% endif %}>
        <p class="cart-upsell__title">{{ 'cart.upsell_title' | t }}</p>
        {%- for up in settings.cart_upsell_products -%}
          {%- if up.available -%}
            {%- assign uv = up.selected_or_first_available_variant -%}
            <div class="cart-upsell__item">
              <a class="cart-upsell__media" href="{{ up.url }}">
                {%- if up.featured_media -%}{{ up.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: up.title }}{%- endif -%}
              </a>
              <div class="cart-upsell__body">
                <p class="cart-upsell__name">{{ up.title | escape }}</p>
                {%- unless up.has_only_default_variant -%}
                  <select class="cart-upsell__select" data-upsell-variant aria-label="{{ up.title | escape }}">
                    {%- for v in up.variants -%}
                      {%- if v.available -%}<option value="{{ v.id }}" data-price="{{ v.price | money | escape }}" data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | escape }}{% endif %}"{% if v.id == uv.id %} selected{% endif %}>{{ v.title | escape }}</option>{%- endif -%}
                    {%- endfor -%}
                  </select>
                {%- endunless -%}
              </div>
              <div class="cart-upsell__side">
                <p class="cart-upsell__price"><b data-upsell-price>{{ uv.price | money }}</b><s data-upsell-compare>{% if uv.compare_at_price > uv.price %}{{ uv.compare_at_price | money }}{% endif %}</s></p>
                <button type="button" class="cart-upsell__add" data-upsell-add data-variant="{{ uv.id }}">{{ 'cart.add' | t }}</button>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  <div class="cart-drawer__foot cart-actions"{% if cart.item_count == 0 %} hidden{% endif %}>
    {%- if settings.protection_mode == 'included' or settings.protection_mode == 'gift' -%}
      <div class="protection protection--included">
        <svg class="protection__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
        <span class="protection__text">
          <b>{% if settings.protection_mode == 'gift' %}🎁 {% endif %}{{ settings.protection_included_title | escape }}</b>
          {%- if settings.protection_product != blank -%}
            <span class="protection__price"><s>{{ settings.protection_product.selected_or_first_available_variant.price | money }}</s> <strong>{{ 'general.free' | t }}</strong></span>
          {%- endif -%}
          <small>{{ settings.protection_included_text | escape }}</small>
        </span>
        <span class="protection__check" aria-hidden="true">✓</span>
      </div>
    {%- elsif settings.protection_mode == 'optional' and settings.protection_product != blank -%}
      {%- assign pv = settings.protection_product.selected_or_first_available_variant -%}
      <label class="protection">
        <svg class="protection__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
        <span class="protection__text"><b>{{ settings.protection_title | escape }}</b> {{ pv.price | money }}<small>{{ settings.protection_text | escape }}</small></span>
        <input class="protection__switch" type="checkbox" role="switch" data-protection-toggle aria-label="{{ settings.protection_title | escape }} {{ pv.price | money | strip_html }}">
      </label>
    {%- endif -%}
    <div class="cart-drawer__total"><span>{{ 'cart.estimated_total' | t }}</span><span id="bag-total">{{ cart.total_price | money_with_currency }}</span></div>
    <p class="cart-drawer__note">{{ 'cart.taxes_note' | t }}</p>
    <form action="{{ routes.cart_url }}" method="post">
      <button class="cart-drawer__checkout" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
      {%- if additional_checkout_buttons -%}
        <div class="cart-drawer__express">{{ content_for_additional_checkout_buttons }}</div>
      {%- endif -%}
    </form>
    <div class="cart-drawer__pay">{% render 'payment-icons' %}</div>
  </div>
</dialog>
