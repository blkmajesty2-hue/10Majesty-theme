{%- comment -%} Cart drawer, filled from the live cart. Also passes money format and strings to blkm.js. {%- endcomment -%}
{%- assign free_ship_cents = settings.free_shipping_threshold | times: 100 | round -%}
<script>
  window.blkm = {
    moneyFormat: {{ shop.money_format | json }},
    currency: {{ cart.currency.iso_code | json }},
    freeShipping: {{ free_ship_cents | default: 0 }},
    protectionMode: {{ settings.protection_mode | json }},
    protectionVariant: {% if settings.protection_mode != 'off' and settings.protection_product != blank %}{{ settings.protection_product.selected_or_first_available_variant.id }}{% else %}null{% endif %},
    strings: {
      addToCart: {{ 'products.add_to_cart' | t | json }},
      soldOut: {{ 'products.sold_out' | t | json }},
      unavailable: {{ 'products.unavailable' | t | json }},
      adding: {{ 'products.adding' | t | json }},
      added: {{ 'products.added' | t | json }},
      error: {{ 'products.error' | t | json }},
      comboUnavailable: {{ 'products.combination_unavailable' | t | json }},
      empty: {{ 'cart.empty' | t | json }},
      remove: {{ 'cart.remove' | t | json }},
      subtotal: {{ 'cart.subtotal' | t | json }},
      discounts: {{ 'cart.discounts' | t | json }},
      quantity: {{ 'cart.quantity' | t | json }},
      item: {{ 'cart.item' | t | json }},
      items: {{ 'cart.items' | t | json }},
      freeShipRemaining: {{ 'cart.free_shipping_remaining' | t | json }},
      freeShipReached: {{ 'cart.free_shipping_reached' | t | json }}
    }
  };
</script>
<dialog id="bag" class="cart-drawer" aria-labelledby="bag-title">
  <div class="cart-drawer__head">
    <h2 id="bag-title">{{ 'cart.title' | t }} <span class="cart-drawer__count" data-cart-count-label></span></h2>
    <button class="close" aria-label="{{ 'general.close' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"/></svg></button>
  </div>
  {%- if free_ship_cents > 0 -%}
    <div class="cart-drawer__ship" data-free-ship hidden>
      <p></p>
      <div class="cart-drawer__bar"><span></span></div>
    </div>
  {%- endif -%}
  <div class="cart-drawer__cols" data-cart-cols hidden><span>{{ 'cart.product' | t }}</span><span>{{ 'cart.total' | t }}</span></div>
  <div id="bag-items" class="cart-drawer__items">
    {%- if cart.item_count == 0 -%}<p class="empty-bag">{{ 'cart.empty' | t }}</p>{%- endif -%}
  </div>
  <div class="cart-drawer__foot cart-actions"{% if cart.item_count == 0 %} hidden{% endif %}>
    {%- if settings.protection_mode == 'included' or settings.protection_mode == 'gift' -%}
      <div class="protection protection--included">
        <svg class="protection__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
        <span class="protection__text">
          <b>{% if settings.protection_mode == 'gift' %}🎁 {% endif %}{{ settings.protection_included_title | escape }}</b>
          {%- if settings.protection_product != blank -%}
            <span class="protection__price"><s>{{ settings.protection_product.selected_or_first_available_variant.price | money }}</s> <strong>FREE</strong></span>
          {%- endif -%}
          <small>{{ settings.protection_included_text | escape }}</small>
        </span>
        <span class="protection__check" aria-hidden="true">✓</span>
      </div>
    {%- elsif settings.protection_mode == 'optional' and settings.protection_product != blank -%}
      {%- assign pv = settings.protection_product.selected_or_first_available_variant -%}
      <label class="protection">
        <svg class="protection__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
        <span class="protection__text"><b>{{ settings.protection_title | escape }}</b> {{ pv.price | money }}<small>{{ settings.protection_text | escape }}</small></span>
        <input class="protection__switch" type="checkbox" role="switch" data-protection-toggle aria-label="{{ settings.protection_title | escape }} {{ pv.price | money | strip_html }}">
      </label>
    {%- endif -%}
    <div class="cart-drawer__total"><span>{{ 'cart.estimated_total' | t }}</span><span id="bag-total">{{ cart.total_price | money_with_currency }}</span></div>
    <p class="cart-drawer__note">{{ 'cart.taxes_note' | t }}</p>
    <form action="{{ routes.cart_url }}" method="post">
      <button class="cart-drawer__checkout" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
    </form>
  </div>
</dialog>
