{%- comment -%} Line icons for feature cards. Accepts: name {%- endcomment -%}
{%- case name -%}
  {%- when 'x' -%}
    <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M12 12l24 24M36 12L12 36"/></svg>
  {%- when 'nodes' -%}
    <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="11" r="4"/><circle cx="12" cy="35" r="4"/><circle cx="36" cy="35" r="4"/><path d="M22 14.5l-8 17M26 14.5l8 17M16 35h16"/></svg>
  {%- when 'wind' -%}
    <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M6 18h24a5 5 0 1 0-5-5M6 26h32a5 5 0 1 1-5 5M6 34h16"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 39S8 29.5 8 18.5A8 8 0 0 1 24 14a8 8 0 0 1 16 4.5C40 29.5 24 39 24 39z"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 6l14 5v11c0 9-6 16-14 20-8-4-14-11-14-20V11z"/><path d="M18 24l4 4 8-8"/></svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 38C10 20 22 10 40 10c0 18-10 28-28 28zM10 38l16-16"/></svg>
  {%- else -%}
    <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M12 25l8 8 16-18"/></svg>
{%- endcase -%}
