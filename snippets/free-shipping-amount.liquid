{%- comment -%} Free-shipping minimum in the shopper's currency (euro / krona thresholds for EUR / SEK carts), e.g. "£60". {%- endcomment -%}
{%- liquid
  assign fs_amount = settings.free_shipping_threshold
  if cart.currency.iso_code == 'EUR' and settings.free_shipping_threshold_eur > 0
    assign fs_amount = settings.free_shipping_threshold_eur
  elsif cart.currency.iso_code == 'SEK' and settings.free_shipping_threshold_sek > 0
    assign fs_amount = settings.free_shipping_threshold_sek
  endif
  echo fs_amount | times: 100 | round | money_without_trailing_zeros
-%}
