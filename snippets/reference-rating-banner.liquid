{% doc %}
Renders the editable reference-store rating banner.
@param {section} section - Product section settings.
{% enddoc %}
<div class="blkm-reference-proof">
  <div class="blkm-reference-proof__photos" aria-hidden="true">
    {% assign photos = '262120138_5135161053168911_4317808011404363710_n.jpg,440963873_10228932907180188_5795405126749105216_n.jpg,70808168_2543092175756262_7125276819086901248_n.jpg' | split: ',' %}
    {% for photo in photos %}
      {% assign key = 'reference_avatar_' | append: forloop.index %}
      {% if section.settings[key] != blank %}
        {{ section.settings[key] | image_url: width: 120 | image_tag: width: 56, height: 56, alt: '', loading: 'lazy' }}
      {% else %}
        <img src="https://cdn.shopify.com/s/files/1/0819/0882/6369/files/{{ photo }}?v=1783066492" width="56" height="56" alt="" loading="lazy">
      {% endif %}
    {% endfor %}
  </div>
  <div class="blkm-reference-proof__copy">
    <div class="blkm-reference-proof__score" aria-label="{{ section.settings.reference_source | escape }}"><span aria-hidden="true">★★★★★</span><b>{{ section.settings.reference_score | escape }}</b></div>
    <p><strong>{{ section.settings.reference_bold | escape }}</strong> {{ section.settings.reference_text | escape }}</p>
  </div>
</div>
{% stylesheet %}
.blkm-reference-proof{display:flex;align-items:center;gap:16px;width:100%;box-sizing:border-box;padding:14px 20px;margin:0 0 18px;border:1px solid #e6dcd2;border-radius:18px;background:#f4f0ec;color:#151515;font-family:inherit;letter-spacing:.3px;line-height:1.3}
.blkm-reference-proof__photos{display:flex;flex:none}
.blkm-reference-proof__photos img{width:44px;height:44px;object-fit:cover;border-radius:50%;border:2px solid #f4f0ec;margin:0 0 0 -10px;max-width:none}
.blkm-reference-proof__photos img:first-child{margin-left:0}
.blkm-reference-proof__copy{min-width:0}
.blkm-reference-proof__score{display:flex;align-items:center;flex-wrap:wrap;gap:7px;margin-bottom:4px}
.blkm-reference-proof__score span{color:#eaa12e;letter-spacing:1px;font-size:20px;line-height:1}
.blkm-reference-proof__score b{font-size:20px;font-weight:800;color:#151515}
.blkm-reference-proof__copy p{margin:0;font-size:16px;line-height:1.4;color:#555}
.blkm-reference-proof__copy strong{color:#151515;font-weight:800}
.product-layout:has(.blkm-reference-proof) .thumbs{gap:10px;margin-top:10px;padding:0 0 4px}
.product-layout:has(.blkm-reference-proof) .thumbs button{border-radius:0;overflow:hidden;flex:0 0 calc((100% - 40px)/5);width:calc((100% - 40px)/5);opacity:1}
.product-layout:has(.blkm-reference-proof) .thumbs img{border-radius:0}
.product-layout:has(.blkm-reference-proof) .product-title{margin-top:0}
@media(max-width:900px){.product-layout:has(.blkm-reference-proof){row-gap:16px}.product-layout:has(.blkm-reference-proof) .gallery{margin-bottom:0}}
@media(max-width:749px){.blkm-reference-proof{gap:10px;padding:10px 12px;border-radius:16px;margin-bottom:16px}.blkm-reference-proof__photos img{width:32px;height:32px;margin-left:-9px}.blkm-reference-proof__score span{font-size:16px;letter-spacing:0}.blkm-reference-proof__score b{font-size:17px}.blkm-reference-proof__copy p{font-size:13px;letter-spacing:.2px}}
{% endstylesheet %}
