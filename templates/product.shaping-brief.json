    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Syns de under kläderna?",
            "answer": "<p>De kantade kanterna och de släta banden är designade för att sitta diskret under kläderna. Hur synliga de är beror på passform, färg och vad du har över.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Passar den efter förlossning eller operation?",
            "answer": "<p>Det här är formande trosor för vardagen, inte ett medicinskt plagg. Om du återhämtar dig efter förlossning eller operation, fråga din läkare innan du använder shapewear.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Vilka storlekar finns?",
            "answer": "<p>Storlekar S till 3XL. Använd storleksguiden och välj den större storleken om du ligger mellan två.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Kan jag välja olika storlekar och färger i samma paket?",
            "answer": "<p>Ja. Välj storlek och färg för varje trosa i ditt paket.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Hur ska jag tvätta den?",
            "answer": "<p>Handtvätta eller maskintvätta kallt på skonsamt program med milt tvättmedel och lufttorka sedan. Undvik blekmedel och sköljmedel.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Hur lång är leveranstiden?",
            "answer": "<p>Leveransalternativ och leveranstider visas i kassan. Läs vår <a href=\"/policies/shipping-policy\">fraktpolicy</a>.</p>"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "question": "Vad gör jag om jag vill returnera min beställning?",
            "answer": "<p>Läs vår <a href=\"/policies/refund-policy\">returpolicy</a> för hur returer fungerar.</p>"
          }
        },
        "q8": {
          "type": "question",
          "settings": {
            "question": "Vilka betalsätt accepterar ni?",
            "answer": "<p>Alla betalsätt vi accepterar visas i kassan och i ikonerna på den här sidan.</p>"
          }
        },
        "q9": {
          "type": "question",
          "settings": {
            "question": "Förändrar shapewear min kroppsform permanent?",
            "answer": "<p>Nej. Shapewear jämnar ut och stöttar medan du bär den; den förändrar inte din kropp permanent.</p>"
          }
        },
        "q10": {
          "type": "question",
          "settings": {
            "question": "Hur länge kan jag ha den på mig?",
            "answer": "<p>Ha den på dig så länge det känns bekvämt. Om den skär in eller begränsar andningen, prova nästa storlek upp.</p>"
          }
        },
        "q11": {
          "type": "question",
          "settings": {
            "question": "Hur fungerar den korsade designen?",
            "answer": "<p>Två överlappande band bildar ett X över framsidan och ger omslutande stöd runt midjan.</p>"
          }
        },
        "q12": {
          "type": "question",
          "settings": {
            "question": "Rullar linningen ner?",
            "answer": "<p>Den strukturerade höga midjan är gjord för att sitta kvar. Rätt storlek är viktigast, så kolla storleksguiden.</p>"
          }
        },
        "q13": {
          "type": "question",
          "settings": {
            "question": "Hur väljer jag storlek?",
            "answer": "<p>Mät din midja och jämför med storleksguiden. Om du ligger mellan två storlekar, välj den större.</p>"
          }
        }
      },
