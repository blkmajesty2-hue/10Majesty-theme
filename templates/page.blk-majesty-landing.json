            "narrow": false,
            "fallback_image": ""
          }
        },
        "text_15": {
          "type": "text",
          "settings": {
            "text": "<p>En kollega la två fingrar ovanför min navel och förklarade bukseparation. Lättnaden var omedelbar: det var inget personligt misslyckande, och vikten ensam var inte problemet.</p>"
          }
        },
        "pull_16": {
          "type": "pull",
          "settings": {
            "text": "Det var inte mitt fel.\nIngen hade förklarat det."
          }
        },
