        "text_2": {
          "type": "text",
          "settings": {
            "text": "<p>Nej. Men du måste sluta göra det som förvärrar problemet. Åtsittande shapewear, år av situps och dieter fokuserar ofta på framsidan medan kroppen går hela vägen runt.</p>"
          }
