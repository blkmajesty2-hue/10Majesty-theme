{% doc %}
  @prompt
    Role: Act as an expert e-commerce conversion rate optimization (CRO) copywriter and direct-response marketer specializing in high-converting social proof for women's shapewear and apparel brands.
    
    Objective: Write a set of 8 authentic, high-converting customer reviews with detailed User-Generated Content (UGC) photo concepts for a high-waisted seamless shapewear product.
    
    Required Framework per Review:
    
    Customer Profile: Real Italian/European first name, realistic age (spanning 34 to 63 years old), and "⭐⭐⭐⭐⭐ (Verified Buyer)".
    
    Specific Pain Point: Address real physical and emotional triggers (e.g., post-partum lower belly/cesarean scar, menopausal weight shift, bloating, lack of confidence in fitted jeans or dresses, frustration with rolling shapewear).
    
    Product Mechanics: Highlight the 360° cross-band support, breathability, zero rolling, and all-day comfort.
    
    Emotional Transformation: Contrast how they felt before (avoiding mirrors, wearing clothes to hide) vs. after wearing the shapewear (freedom, confidence, breathing easily).
    
    UGC Visual Concept: Describe an authentic smartphone photo matching the review (e.g., iPhone mirror selfie in jeans, side-profile in a cocktail dress, family lunch candid).
    
    Tone & Style: Conversational, vulnerable, highly relatable, and entirely free of corporate jargon or robotic marketing speak. Write as if real women are texting their best friend or leaving a genuine review.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-customer-review-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 24px;
    border: 1px solid #dedede;
    border-radius: 12px;
    background: #ffffff;
    color: #202020;
    font-family: Arial, sans-serif;
  }
  .ai-customer-review-{{ ai_gen_id }}__stars { margin: 0 0 12px; color: #6b4b00; font-size: 16px; letter-spacing: 2px; }
  .ai-customer-review-{{ ai_gen_id }}__quote { margin: 0 0 18px; font-size: 16px; line-height: 1.6; }
  .ai-customer-review-{{ ai_gen_id }}__author { margin: 0; font-size: 14px; font-weight: 700; }
  .ai-customer-review-{{ ai_gen_id }}__verification { display: inline-block; margin-top: 5px; font-size: 12px; line-height: 1.4; color: #454545; }
  .ai-customer-review-{{ ai_gen_id }}__image { display: block; width: 100%; height: auto; margin-bottom: 16px; border-radius: 8px; }
  .ai-customer-review-{{ ai_gen_id }}__placeholder { display: flex; aspect-ratio: 4 / 3; align-items: center; justify-content: center; margin-bottom: 16px; overflow: hidden; border-radius: 8px; background: #f2f2f2; }
  .ai-customer-review-{{ ai_gen_id }}__placeholder svg { display: block; width: 100%; height: 100%; color: #686868; }
{% endstyle %}

<article class="ai-customer-review-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.customer_photo %}
    <img class="ai-customer-review-{{ ai_gen_id }}__image" src="{{ block.settings.customer_photo | image_url: width: 1000 }}" alt="{{ block.settings.customer_photo.alt | default: 'Customer-submitted product photo' | escape }}" width="{{ block.settings.customer_photo.width }}" height="{{ block.settings.customer_photo.height }}" loading="lazy">
  {% else %}
    <div class="ai-customer-review-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
  {% endif %}
  {% if block.settings.rating > 0 %}
    <p class="ai-customer-review-{{ ai_gen_id }}__stars" aria-label="Rated {{ block.settings.rating }} out of 5">{% for i in (1..block.settings.rating) %}★{% endfor %}{% for i in (1..5) %}{% if i > block.settings.rating %}☆{% endif %}{% endfor %}</p>
  {% endif %}
  {% if block.settings.review_text != blank %}<blockquote class="ai-customer-review-{{ ai_gen_id }}__quote">{{ block.settings.review_text | escape | newline_to_br }}</blockquote>{% endif %}
  {% if block.settings.customer_name != blank %}<p class="ai-customer-review-{{ ai_gen_id }}__author">{{ block.settings.customer_name | escape }}</p>{% endif %}
  {% if block.settings.verified_purchase %}<span class="ai-customer-review-{{ ai_gen_id }}__verification">Verified purchase</span>{% endif %}
</article>

{% schema %}
{
  "name": "Customer review card",
  "settings": [
    { "type": "header", "content": "Review from a real customer" },
    { "type": "paragraph", "content": "Only publish a genuine customer-submitted review. Select verified purchase only when your order records confirm it, and use customer photos with permission." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "textarea", "id": "review_text", "label": "Customer's review" },
    { "type": "text", "id": "customer_name", "label": "Customer name" },
    { "type": "range", "id": "rating", "label": "Rating from customer", "min": 0, "max": 5, "step": 1, "default": 0 },
    { "type": "checkbox", "id": "verified_purchase", "label": "Verified purchase (confirm from order records)", "default": false },
    { "type": "image_picker", "id": "customer_photo", "label": "Customer photo (with permission)" }
  ],
  "presets": [{ "name": "Customer review card" }],
  "tag": null,
  "class": "customer-review-card"
}
{% endschema %}