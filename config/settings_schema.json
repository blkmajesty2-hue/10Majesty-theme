[
  {
    "name": "theme_info",
    "theme_name": "BLK_MAJESTY",
    "theme_version": "1.0.0",
    "theme_author": "BLK_MAJESTY",
    "theme_documentation_url": "https://github.com/blkmajesty2-hue/10Majesty-theme",
    "theme_support_url": "https://github.com/blkmajesty2-hue/10Majesty-theme"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "select",
        "id": "font_style",
        "label": "Font",
        "default": "helvetica",
        "options": [
          {
            "value": "helvetica",
            "label": "Helvetica / Arial (matches the reference site)"
          },
          {
            "value": "library",
            "label": "Font picked below"
          }
        ]
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Font from Shopify's library",
        "default": "poppins_n4"
      }
    ]
  },
  {
    "name": "General",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "text",
        "id": "cart_note",
        "label": "Cart note",
        "default": "Taxes and shipping are calculated at checkout."
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping from (store currency)",
        "info": "Shows a progress bar in the cart. Use your real free-shipping minimum from Settings → Shipping. Set 0 to hide.",
        "default": 135
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram link"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok link"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook link"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "product",
        "id": "protection_product",
        "label": "Shipping protection product",
        "info": "Shows an opt-in toggle in the cart that adds this product. Leave empty to hide."
      },
      {
        "type": "text",
        "id": "protection_title",
        "label": "Toggle title",
        "default": "Shipping Protection"
      },
      {
        "type": "text",
        "id": "protection_text",
        "label": "Toggle text",
        "default": "Get a full refund if the order is lost or damaged in transit."
      }
    ]
  }
]
