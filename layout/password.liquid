<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {%- liquid
      assign body_font = settings.type_body_font
      assign font_600 = body_font | font_modify: 'weight', '600'
      assign font_700 = body_font | font_modify: 'weight', '700'
      assign font_italic = body_font | font_modify: 'style', 'italic'
    -%}
    {% style %}
      {{ body_font | font_face: font_display: 'swap' }}
      {%- if font_600 %}{{ font_600 | font_face: font_display: 'swap' }}{% endif -%}
      {%- if font_700 %}{{ font_700 | font_face: font_display: 'swap' }}{% endif -%}
      {%- if font_italic %}{{ font_italic | font_face: font_display: 'swap' }}{% endif %}
      :root { --font-body: {{ body_font.family }}, {{ body_font.fallback_families }}; }
    {% endstyle %}
    {{ 'blkm.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
