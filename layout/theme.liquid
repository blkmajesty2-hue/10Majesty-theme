<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    {%- liquid
      assign body_font = settings.type_body_font
      assign font_600 = body_font | font_modify: 'weight', '600'
      assign font_700 = body_font | font_modify: 'weight', '700'
      assign font_800 = body_font | font_modify: 'weight', '800'
      assign font_italic = body_font | font_modify: 'style', 'italic'
    -%}
    {% style %}
      {{ body_font | font_face: font_display: 'swap' }}
      {%- if font_600 %}{{ font_600 | font_face: font_display: 'swap' }}{% endif -%}
      {%- if font_700 %}{{ font_700 | font_face: font_display: 'swap' }}{% endif -%}
      {%- if font_800 %}{{ font_800 | font_face: font_display: 'swap' }}{% endif -%}
      {%- if font_italic %}{{ font_italic | font_face: font_display: 'swap' }}{% endif %}
      :root { --font-body: {{ body_font.family }}, {{ body_font.fallback_families }}; }
    {% endstyle %}
    {{ 'blkm.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'blkm.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% render 'cart-dialog' %}
  </body>
</html>
